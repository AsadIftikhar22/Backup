		<ProjectReference Include="..\Salam.Cms.Core.Settings\Salam.Cms.Core.Settings.csproj" />
		<ProjectReference Include="..\Salam.Cms.Shared.Models\Salam.Cms.Shared.Models.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="CallToAction\Enums\" />
	  <Folder Include="Common\Components\PageNavigator\Components\" />
	</ItemGroup>

</Project>
