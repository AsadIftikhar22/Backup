@using Salam.Cms.Core.Settings.Abstract
@using Salam.Cms.Web.Features.Settings.Models

@{
    Layout = "_Layout";
}

@inject ISettingsManager _settingsManager

@{
    var DXPSlugOptimizelySource =
        _settingsManager.GetSettings<WebLayoutSettings>()?.DXPSlugOptimizelySource;
}

@if (DXPSlugOptimizelySource != null && DXPSlugOptimizelySource.Any())
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const dxpSlugs = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(DXPSlugOptimizelySource)
                    );

        if (!Array.isArray(dxpSlugs) || dxpSlugs.length === 0) {
            return;
        }

            document.querySelectorAll('a[href]').forEach(link => {
                const href = link.getAttribute('href');

                if (!href || !href.startsWith('/') || href.startsWith('/dxp/')) {
                    return;
                }

                const shouldMapToDxp = dxpSlugs.some(slug => {

                    if (!slug) {
                        return false;
                    }

                    slug = slug.replace(/\/$/, '');

                    return href === slug || href.startsWith(slug + '/');
                });

                if (shouldMapToDxp) {
                    link.setAttribute('href', '/dxp' + href);
                }
            });
        });
    </script>
}
