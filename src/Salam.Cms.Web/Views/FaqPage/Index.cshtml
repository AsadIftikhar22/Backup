@using Salam.Cms.Web.Features.FaqPage.ViewModels
@using System

@model FaqPageViewModel

<style>
/* Same background as Customer Rights / Our Stores: grey, no green */
body.faq-page,
html:has(body.faq-page) {
    background-color: #f1f1f1 !important;
    overflow-x: hidden !important;
}
body.faq-page main {
    background-color: #f1f1f1 !important;
}
body.faq-page .dxp-layout-content-area,
body.faq-page .entry-content-page,
body.faq-page .faq-page-wrapper,
body.faq-page .voiphone--section,
body.faq-page .salam-layout {
    background-color: #f1f1f1 !important;
}
body.faq-page .entry-content-page .wpb_wrapper > p {
    display: none !important;
}
/* Prevent horizontal scroll: override global .vc_row negative margins */
body.faq-page .vc_row {
    margin-left: 0 !important;
    margin-right: 0 !important;
}
body.faq-page .salam-layout,
body.faq-page .dxp-layout-content-area {
    overflow-x: hidden !important;
    max-width: 100vw;
}
/* Ensure FAQ text is dark on grey background (override any white text from shell) */
body.faq-page .section-title h2,
body.faq-page .single-faq .faq-question,
body.faq-page .single-faq .faq-question p,
body.faq-page .single-faq .faq-answer,
body.faq-page .single-faq .faq-answer p {
    color: #002035 !important;
}
/* RTL (Arabic): text alignment */
html[dir="rtl"] body.faq-page .section-title h2 { text-align: center; }
html[dir="rtl"] body.faq-page .single-faq .faq-question,
html[dir="rtl"] body.faq-page .single-faq .faq-answer { text-align: right; }
</style>
<div class="salam-layout">
<div class="dxp-layout-content-area">
    <div class="entry-content-page post--content">
        <div class="vc_row wpb_row vc_row-fluid">
            <div class="remove-top-padding faq-page-wrapper wpb_column vc_column_container vc_col-sm-12">
                <div class="vc_column-inner">
                    <div class="wpb_wrapper">
                        <div id="voiphone-section-@Guid.NewGuid().ToString("N")" class="voiphone--section pt-100 pb-50 faq-paragraph-padding">
                            <div class="container">
                                @if (!string.IsNullOrEmpty(Model.CurrentPage.Heading))
                                {
                                    <div id="heading-@Guid.NewGuid().ToString("N")" class="section-title text-center">
                                        <h2>@Html.PropertyFor(m => m.CurrentPage.Heading)</h2>
                                    </div>
                                }
                                <div class="vc_row wpb_row vc_inner vc_row-fluid">
                                    @Html.PropertyFor(x => x.CurrentPage.MainContent)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
