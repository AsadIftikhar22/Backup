@using Salam.Cms.Web.Features.TelecomItRightsPage.ViewModels

@model TelecomItRightsPageViewModel

<style>
/* Remove green gradient bar on right and horizontal scroll */
body.telecom-it-rights-page,
html:has(body.telecom-it-rights-page) {
    background-color: #f1f1f1 !important;
    overflow-x: hidden !important;
}
body.telecom-it-rights-page main {
    background-color: #f1f1f1 !important;
    background-image: none !important;
    overflow-x: hidden !important;
}
body.telecom-it-rights-page main::before,
body.telecom-it-rights-page main::after {
    display: none !important;
}
body.telecom-it-rights-page .entry-content-page .wpb_wrapper > p {
    display: none !important;
}
/* Contain row negative margins so they don't cause page overflow */
body.telecom-it-rights-page .salam-layout,
body.telecom-it-rights-page .dxp-layout-content-area,
body.telecom-it-rights-page .entry-content-page {
    overflow-x: hidden !important;
    max-width: 100vw;
}
body.telecom-it-rights-page .vc_row {
    max-width: 100%;
}
/* RTL: accordion heading right, icon left (page-level so it always applies) */
html[dir="rtl"] body.telecom-it-rights-page .it-rights-container-wrapper .accordion-container .single-accordion .accordion-header {
    direction: ltr !important;
    flex-direction: row-reverse !important;
}
</style>
<div class="salam-layout">
    <div class="dxp-layout-content-area">
        <div class="entry-content-page post--content">
            <div class="vc_row wpb_row vc_row-fluid">
                <div class="wpb_column vc_column_container vc_col-sm-12">
                    <div class="vc_column-inner">
                        <div class="wpb_wrapper">
                            @Html.PropertyFor(x => x.CurrentPage.MainContent)
                            @if (Model.CurrentPage.CustomCss != null && !string.IsNullOrWhiteSpace(Model.CurrentPage.CustomCss.ToString()))
                            {
                                <style>@Html.Raw(Model.CurrentPage.CustomCss)</style>
                            }
                            @if (Model.CurrentPage.CustomHtml != null && !string.IsNullOrWhiteSpace(Model.CurrentPage.CustomHtml.ToString()))
                            {
                                @Html.Raw(Model.CurrentPage.CustomHtml)
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
