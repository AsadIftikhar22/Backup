@using EPiServer
@using EPiServer.Core
@using EPiServer.Web.Routing
@using EPiServer.Globalization
@using Salam.Cms.Shared.Models.Pages.Container
@using Salam.Cms.Web.Features.Home.Models

@inject IContentLoader ContentLoader
@inject IContentRouteHelper ContentRouteHelper
@inject IContentLanguageAccessor ContentLanguageAccessor

@{
    var currentContent = ContentRouteHelper.Content;

    if (currentContent == null)
    {
        return;
    }

    var culture = ContentLanguageAccessor.Language;

    // Load current page in the current language
    if (!ContentLoader.TryGet<PageData>(
            currentContent.ContentLink,
            culture,
            out var currentPage))
    {
        return;
    }

    var breadcrumbs = new List<PageData>();

    // Get ancestors
    var ancestors = ContentLoader
        .GetAncestors(currentPage.ContentLink)
        .OfType<PageData>()
        .Reverse()
        .SkipWhile(x =>
            !x.ContentLink.CompareToIgnoreWorkID(ContentReference.StartPage))
        .Skip(1)
        .ToList();

    foreach (var ancestor in ancestors)
    {
        // Explicitly load ancestor in current culture
        if (!ContentLoader.TryGet<PageData>(
                ancestor.ContentLink,
                culture,
                out var page))
        {
            // Do NOT fall back to English
            continue;
        }

        if (page is ContainerPage)
        {
            // Get children using the current culture
            var children = ContentLoader
                .GetChildren<PageData>(
                    page.ContentLink,
                    culture)
                .ToList();

            var child = children.FirstOrDefault(x =>
                x.ContentLink.CompareToIgnoreWorkID(currentPage.ContentLink));

            if (child != null)
            {
                breadcrumbs.Add(child);
            }
        }
        else
        {
            breadcrumbs.Add(page);
        }
    }

    // If there is only one breadcrumb, don't show it
    var items = breadcrumbs.Count == 1
        ? new List<PageData>()
        : breadcrumbs;
}

@if (items.Any())
{
    <nav class="breadcrumb" aria-label="breadcrumb">

        @for (var i = 0; i < items.Count - 1; i++)
        {
            var item = items[i];

            <a href="@Url.ContentUrl(item.ContentLink)"
               class="button button-theme--transparent-secondary breadcrumb__link">

                @item.Name

                <div class="arrow">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </a>
        }

        <a class="button button-theme--transparent-secondary breadcrumb__link">
            @currentPage.Name
        </a>

    </nav>
}

<style>
    .breadcrumb {
        padding: var(--spacing-4);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        margin: auto;
        max-width: 1312.67px;
        padding-left: 96px;
    }

    .breadcrumb__link {
        color: #74C947;
        text-decoration: none;
        padding-left: 3px;
    }

    .button-theme--transparent-primary,
    .button-theme--transparent-secondary {
        flex-direction: row;
    }

    .breadcrumb__link:hover {
        text-decoration: underline;
    }

    .breadcrumb__separator {
        color: #5b6b66;
        margin: 0 8px;
    }

    .button-theme--transparent-primary .arrow,
    .button-theme--transparent-secondary .arrow {
        margin: 0;
    }

    .breadcrumb__current {
        color: #74C947;
    }

    .breadcrumb .button-theme--transparent-primary .arrow,
    .breadcrumb .button-theme--transparent-secondary .arrow {
        margin: 0;
        margin-left: 10px;
    }

    @@media (max-width: 1200px) {
        .breadcrumb__link {
            min-height: 27px !important;
            padding-left: 3px !important;
        }
    }
</style>
