    /* Governance nav-tabs used as plain toggle buttons */
    .salam-layout .gov-tab-btn {
        background-color: #fff;
        color: #000;
        border: none;
        border-radius: 8px;
        padding: 15px 56px;
        font-size: 16px;
        cursor: pointer;
        line-height: 24px;
        font-weight: 500;
        width: 100%;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .salam-layout .gov-tab-btn.active {
            background-color: #e6fde7;
            color: #01a809;
        }

        .salam-layout .gov-tab-btn:hover {
            background-color: #e6fde7;
            color: #01a809;
        }

    /* 4-card strategy wrapper needs more bottom room for stacked card overflow */
    .strategy-wrapper.has-cards {
        margin-bottom: 250px !important;
    }

    /* Vision/Mission section — compact spacing */
    .vision-mission-wrapper {
        padding: 48px 0 48px 0;
        margin-bottom: 0;
    }

    /* ─── Mobile Responsive Fixes ──────────────────────────────────────────────── */

    /* Reduce container-full horizontal padding on tablet and below */
    @@media screen and (max-width: 992px) {
        .container-full

    {
        padding: 0 20px;
    }

    }

    /* Governance / stats tab buttons: reduce padding and font on small screens */
    @@media screen and (max-width: 768px) {
        .salam-layout .gov-tab-btn

    {
        padding: 12px 16px;
        font-size: 14px;
    }

    .salam-layout .info {
        margin-bottom: 32px;
    }

    /* Owl carousel: prevent slide images from overflowing on mobile */
    .salam-layout .corporate-governance-owl {
        overflow: hidden;
    }

    /* Vision/Mission and governance cards: full width on mobile */
    .salam-layout .ir-card.pad-lg {
        padding: 20px;
    }

    .salam-layout .ir-card.pad-md {
        padding: 16px;
    }

    /* Strategy/sustainability section padding reduction on mobile */
    .salam-layout .strategy,
    .salam-layout .corporate-governance {
        padding: 32px 0;
    }

    .salam-layout .corporate-governance-slide {
        height: auto;
    }

    .corporate-governance-slide img {
        height: 300px;
    }

    }

    @@media screen and (max-width: 576px) {
        /* Governance tab buttons should stack/shrink gracefully */
        .salam-layout .gov-tab-btn

    {
        padding: 10px 8px;
        font-size: 13px;
    }

    /* Container-full down to minimum padding on very small screens */
    .container-full {
        padding: 0 12px;
    }

    /* Reduce section spacing */
    .salam-layout .info {
        margin-bottom: 24px;
    }

    .salam-layout .strategy,
    .salam-layout .corporate-governance {
        padding: 24px 0;
    }

    /* Prevent owl items overflowing on tiny screens */
    .corporate-governance-owl .owl-item {
        min-width: 0;
    }

    /* Stats tab-card full width on mobile */
    .salam-layout .drop-section .stats .tab-content .tab-pane .col-md-6 {
        width: 100%;
    }

    }
</style>
<body data-content-link="@Model?.CurrentPage?.ContentLink?.ID">
    @await Component.InvokeAsync(typeof(NoScriptTagManagerViewComponent))
    @Html.RequiredClientResources(ClientResourceConstants.BodyStart)
    <main>
        @RenderBody()
    </main>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="~/static/assets/js/owl.carousel.min.js"></script>
    @Html.RequiredClientResources(RenderingTags.Footer)

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        // ─── OWL Carousel helpers (defined here so setLanguage can call them) ────

        // Build OWL options that respect the current page direction
        function buildOwlOptions() {
          var isRTL = document.documentElement.getAttribute("dir") === "rtl";
          return {
            loop: true,
            margin: 10,
            rtl: isRTL,
            responsiveClass: true,
            responsive: {
              0: { items: 1, nav: false },
              600: { items: 3, nav: false },
              1000: {
                items: 5,
                nav: true,
                loop: true,
                navText: isRTL ? [
                  '<i class="fa fa-angle-right" aria-hidden="true"><img src="https://images2.cmp.optimizely.com/Zz1mMWFiNzgzNjExNWYxMWYxOWJiYzhhZWJlNjU1MWU4ZA==" /></i>',
                  '<i class="fa fa-angle-left" aria-hidden="true"><img src="https://images3.cmp.optimizely.com/Zz1mMjFkNzU0ZTExNWYxMWYxOTk5YzFlNzUyZTdmMTk0YQ==" /></i>',
                ] : [
                  '<i class="fa fa-angle-left" aria-hidden="true"><img src="https://images3.cmp.optimizely.com/Zz1mMjFkNzU0ZTExNWYxMWYxOTk5YzFlNzUyZTdmMTk0YQ==" /></i>',
                  '<i class="fa fa-angle-right" aria-hidden="true"><img src="https://images2.cmp.optimizely.com/Zz1mMWFiNzgzNjExNWYxMWYxOWJiYzhhZWJlNjU1MWU4ZA==" /></i>',
                ],
              },
            },
          };
        }

        // Destroy and re-init an already-loaded carousel (safe to call any time)
        function reinitOwlIfLoaded(selector) {
          var $el = $(selector);
          if ($el.length && $el.hasClass("owl-loaded")) {
            $el
              .trigger("destroy.owl.carousel")
              .removeClass("owl-loaded owl-drag");
            $el.owlCarousel(buildOwlOptions());
          }
        }

        // ─── Language Switcher ───────────────────────────────────────────────────
        function closeMobileLangDropdown() {
          var d = document.getElementById("mobile-lang-dropdown");
          if (d) d.style.display = "none";
        }

        function setLanguage(lang) {
          var html = document.documentElement;
          var label = lang === "ar" ? "AR" : "EN";
          if (lang === "ar") {
            html.setAttribute("lang", "ar");
            html.setAttribute("dir", "rtl");
          } else {
            html.setAttribute("lang", "en");
            html.setAttribute("dir", "ltr");
          }
          var desktopLabel = document.getElementById("lang-btn-label");
          if (desktopLabel) desktopLabel.textContent = label;
          var mobileLabel = document.getElementById("mobile-lang-label");
          if (mobileLabel) mobileLabel.textContent = label;
          localStorage.setItem("salam-ir-lang", lang);
          // Reinit carousels only if document.ready has already run
          // (owlInitialized flag is set after first init in document.ready)
          if (window.owlInitialized) {
            reinitOwlIfLoaded(".owl-bod");
            reinitOwlIfLoaded(".owl-leadership");
          }
        }

        // Restore saved language on load (runs before document.ready —
        // owlInitialized is false here so no carousel reinit is attempted)
        window.owlInitialized = false;
        (function () {
          var saved = localStorage.getItem("salam-ir-lang");
          if (saved === "ar") setLanguage("ar");
        })();

        // ─── Mobile Menu ─────────────────────────────────────────────────────────
        var toggleBtn = document.getElementById("menu-toggle-DXP");
        var mobilePanel = document.getElementById("mobile-nav-panel");
        if (toggleBtn) {
          toggleBtn.addEventListener("click", function () {
            mobilePanel.classList.toggle("open");
          });
        }

        var mobileLangBtn = document.getElementById("mobile-lang-toggle-btn");
        var mobileLangDropdown = document.getElementById("mobile-lang-dropdown");
        if (mobileLangBtn) {
          mobileLangBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            var isOpen = mobileLangDropdown.style.display === "block";
            mobileLangDropdown.style.display = isOpen ? "none" : "block";
          });
        }
        document.addEventListener("click", function () {
          closeMobileLangDropdown();
        });

        // ─── Cards Slider + Owl Carousel ─────────────────────────────────────────
        $(document).ready(function () {
          // Set staggered margin-top for stacked card sliders
          $(".sustainability-wrapper .cards-slider .slide-wrap").each(
            function (index) {
              if (index > 0) $(this).css("margin-top", index * 70 + "px");
            },
          );
          $(".strategy-wrapper .cards-slider .slide-wrap").each(function (index) {
            if (index > 0) $(this).css("margin-top", index * 70 + "px");
          });

          // Click to bring card to front
          $(".cards-slider .slide-wrap").on("click", function () {
            var slides = $(this).closest(".cards-slider").find(".slide-wrap");
            var clickedIndex = slides.index(this);
            slides.each(function (i) {
              var z = slides.length - Math.abs(clickedIndex - i);
              $(this).css("z-index", z);
              if (i === clickedIndex) $(this).addClass("active");
              else $(this).removeClass("active");
            });
          });

          // Init BOD carousel — buildOwlOptions() reads dir already set by IIFE
          // so RTL is correct on first load even when Arabic is restored from storage
          $(".owl-bod").owlCarousel(buildOwlOptions());
          window.owlInitialized = true;

          // Governance toggle buttons
          $("#bod-tab").on("click", function () {
            $(this).addClass("active");
            $("#leadership-tab").removeClass("active");
            $("#bod-carousel-wrapper").show();
            $("#leadership-carousel-wrapper").hide();
          });

          $("#leadership-tab").on("click", function () {
            $(this).addClass("active");
            $("#bod-tab").removeClass("active");
            $("#bod-carousel-wrapper").hide();
            $("#leadership-carousel-wrapper").show();
            // Init leadership carousel only on first reveal
            if (!$(".owl-leadership").hasClass("owl-loaded")) {
              $(".owl-leadership").owlCarousel(buildOwlOptions());
            }
          });

          // ─── Tab scroll navigation ────────────────────────────────────────────
          window.scrollToSection = function (sectionId, btn) {
            var target = document.getElementById(sectionId);
            if (!target) return;
            var offset = 80; // clearance for sticky header
            var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: top, behavior: "smooth" });
            // update active state immediately on click
            document.querySelectorAll("#myTab .nav-link").forEach(function (b) {
              b.classList.remove("active");
              b.setAttribute("aria-selected", "false");
            });
            btn.classList.add("active");
            btn.setAttribute("aria-selected", "true");
          };

          // Keep tabs in sync as the user scrolls
          var tabSections = [
            { id: "section-glance", tabId: "salam-tab" },
            { id: "section-strategy", tabId: "strategy-tab" },
            { id: "section-vision", tabId: "vision-tab" },
            { id: "section-corporate", tabId: "corporate-tab" },
          ];
          window.addEventListener("scroll", function () {
            var scrollY = window.pageYOffset + 120;
            var current = tabSections[0].tabId;
            tabSections.forEach(function (s) {
              var el = document.getElementById(s.id);
              if (el && el.offsetTop <= scrollY) current = s.tabId;
            });
            document.querySelectorAll("#myTab .nav-link").forEach(function (b) {
              var isActive = b.id === current;
              b.classList.toggle("active", isActive);
              b.setAttribute("aria-selected", isActive ? "true" : "false");
            });
          });

          // Read More / Read Less functionality for custom controller cards
          $(".custom-controller-card-readmore").each(function () {
            const $btn = $(this);
            const $spans = $btn.find("span");
            // Store original text
            $btn.data("original-en", $spans.filter(".en").text());
            $btn.data("original-ar", $spans.filter(".ar").text());
          });

          $(".custom-controller-card-readmore").on("click", function (e) {
            e.preventDefault();
            const $readMoreBtn = $(this);
            const $description = $readMoreBtn.siblings(
              ".custom-controller-card-description",
            );
            const isExpanded = $description.hasClass("expanded");

            // Toggle expanded state
            $description.toggleClass("expanded");

            // Update read more button text
            const $spans = $readMoreBtn.find("span");
            const originalEn = $readMoreBtn.data("original-en");
            const originalAr = $readMoreBtn.data("original-ar");

            if (isExpanded) {
              // Collapse mode - show "Read More" text
              $spans.filter(".en").text(originalEn);
              $spans.filter(".ar").text(originalAr);
            } else {
              // Expand mode - show "Read Less" text
              $spans.filter(".en").text("Read Less");
              $spans.filter(".ar").text("اقرأ أقل");
            }
          });
        });
    </script>
</body>
</html>