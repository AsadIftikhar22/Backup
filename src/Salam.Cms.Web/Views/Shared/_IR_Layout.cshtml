    /* ─── Bilingual (EN / AR) Support ─────────────────────────────────────────── */

    /* Arabic font */
    html[lang="ar"] body {
        font-family: "IBM Plex Sans Arabic", "Codec Pro", sans-serif;
    }

    /* Show/hide language variants */
    .ar {
        display: none;
    }

    .en {
        display: inline;
    }

    html[lang="ar"] .ar {
        display: inline;
    }

    html[lang="ar"] .en {
        display: none;
    }

    /* For block-level bilingual wrappers */
    p .ar,
    div.ar,
    h1.ar,
    h2.ar,
    h3.ar,
    h4.ar {
        display: none;
    }

    p .en,
    div.en,
    h1.en,
    h2.en,
    h3.en,
    h4.en {
        display: inline;
    }

    html[lang="ar"] p .ar,
    html[lang="ar"] div.ar,
    html[lang="ar"] h1.ar,
    html[lang="ar"] h2.ar,
    html[lang="ar"] h3.ar,
    html[lang="ar"] h4.ar {
        display: inline;
    }

    html[lang="ar"] p .en,
    html[lang="ar"] div.en,
    html[lang="ar"] h1.en,
    html[lang="ar"] h2.en,
    html[lang="ar"] h3.en,
    html[lang="ar"] h4.en {
        display: none;
    }

