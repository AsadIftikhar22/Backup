@using Castle.Core.Internal
@using Salam.Cms.Shared.Models.Catalogue.Data
@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers

@model (ProductSku item, string? handoffUrl, string? ButtonText)

@if (!Model.handoffUrl.IsNullOrEmpty() && !Model.item.CorrelatedId.IsNullOrEmpty())
{
    <div class="plan-card__footer">
        <a href="@(Model.handoffUrl + Model.item?.CorrelatedId?.ToString())" class="button button-theme--simple-outlined plan-card__footer-button">
            <span>@Model.ButtonText</span>
            <div class="arrow"><span></span><span></span><span></span><span></span><span></span></div>
        </a>
    </div>
}

@if (!Model.item.buy_now_link.IsNullOrEmpty())
{
    <div class="plan-card__footer">
        <a href="@Model.item.buy_now_link" class="button button-theme--primary plan-card-banner__footer-button plan-card__footer-details-button">
            <span>@Model.ButtonText</span>
            <div class="arrow"><span></span><span></span><span></span><span></span><span></span></div>
        </a>
    </div>
}