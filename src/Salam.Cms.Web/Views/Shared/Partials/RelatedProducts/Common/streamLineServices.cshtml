@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers
@using static Salam.Cms.Shared.Models.SalamConstants

@model ProductSku


@if (!String.IsNullOrWhiteSpace(Model.streamLineServices))
{
    string[] streamLineServices = Model.streamLineServices?
                                       .Split(',')
                                       .Select(s => s.Trim())
                                       .Where(s => s.Length > 0)
                                       .ToArray()!;
    <li class="list-item">
        <div class="list-item__content">
            <span class="list-item__content__text image-wrapper">
                @ContentHelper.GetDefaultFrontendLabel(Model, CatalogueAPIfields.streamLineServices)
                @foreach (var streamicon in streamLineServices)
                {
                    @if (streamicon == "youtube")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g clip-path="url(#clip0_34309_36473)">
                                <path d="M15.8363 11.759C13.6358 10.0848 11.5288 8.5456 9.375 6.9386V16.5521C11.6414 14.798 14.0303 13.1916 15.8456 11.759H15.8363Z" fill="#FDFFFD" />
                                <path d="M15.8363 11.759C13.6358 10.0848 9.375 6.9386 9.375 6.9386L15.0557 12.3745C15.0557 12.3745 14.0209 13.1916 15.8363 11.759Z" fill="#E8E0E0" />
                                <path d="M10.3147 24.156C5.74401 24.0362 4.18289 23.9285 3.22334 23.647C2.57414 23.46 2.00998 23.0448 1.59632 22.4425C1.27662 21.9868 1.02237 21.2913 0.825118 20.3265C0.655916 19.5227 0.590016 18.8539 0.496064 17.2203C0.352242 13.5334 0.317956 10.519 0.496064 7.151C0.643003 5.29106 0.714246 3.0831 1.69028 1.79497C2.15113 1.1921 2.68723 0.80414 3.28924 0.643757C4.22965 0.389553 8.23618 0.188599 12.3839 0.188599C16.5222 0.188599 20.5376 0.389553 21.4789 0.643757C22.231 0.844711 22.9363 1.44694 23.3504 2.2235C24.2409 4.21783 24.2565 6.69774 24.3469 8.63755C24.3843 9.56182 24.3843 14.8101 24.3469 15.7343C24.2062 18.8 24.0931 19.8847 23.7734 21.0092C23.5757 21.7192 23.4069 22.0939 23.1148 22.5091C22.6567 23.1481 22.0727 23.5731 21.4406 23.7275C17.4853 24.151 14.1266 24.2429 10.3147 24.156ZM16.3717 11.8376C14.1712 10.1634 12.0642 8.61093 9.91039 7.00393V16.618C12.1768 14.864 14.5661 13.257 16.381 11.8243L16.3717 11.8376Z" fill="#CD201F" />
                            </g>
                            <defs>
                                <clipPath id="clip0_34309_36473">
                                    <rect width="24" height="24" fill="white" />
                                </clipPath>
                            </defs>
                        </svg>
                    }

                    @if (streamicon == "osn")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                            <rect width="24" height="24" rx="4.5" fill="url(#pattern0_34309_36478)" />
                            <defs>
                                <pattern id="pattern0_34309_36478" patternContentUnits="objectBoundingBox" width="1" height="1">
                                    <use xlink:href="#image0_34309_36478" transform="scale(0.00416667)" />
                                </pattern>
                                <image id="image0_34309_36478" width="240" height="240" preserveAspectRatio="none" xlink:href="data:image/png;base64," />
                            </defs>
                        </svg>

                    }

                    @if (streamicon == "viu")
                    {
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                            <rect width="24" height="24" fill="url(#pattern0_34309_36479)" />
                            <defs>
                                <pattern id="pattern0_34309_36479" patternContentUnits="objectBoundingBox" width="1" height="1">
                                    <use xlink:href="#image0_34309_36479" transform="translate(-0.0769231 -0.0769231) scale(0.00480769)" />
                                </pattern>
                                <image id="image0_34309_36479" width="240" height="240" preserveAspectRatio="none" xlink:href="data:image/png;base64," />
                            </defs>
                        </svg>


                    }
                }
            </span>
        </div>
        <div class="list-item__tooltip"></div>
    </li>
}

<style>
    .image-wrapper {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        align-items: center;
    }
</style>