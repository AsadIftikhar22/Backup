@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers
@using static Salam.Cms.Shared.Models.SalamConstants

@model ProductSku
@if (!String.IsNullOrEmpty(@Model.on_net_landline_free_minutes))
{
    <li class="list-item">
        <div class="list-item__content">
            <span class="list-item__content__text">
                <strong>@Model.on_net_landline_free_minutes</strong>
                @ContentHelper.GetDefaultFrontendLabel(Model, CatalogueAPIfields.on_net_landline_free_minutes)
            </span>
        </div>
        <div class="list-item__tooltip"></div>
    </li>
}