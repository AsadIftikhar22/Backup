@using Salam.Cms.Shared.Models.Catalogue.Data
@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers
@using static Salam.Cms.Shared.Models.SalamConstants
@model ProductSku

@if (!string.IsNullOrEmpty(Model.SocialMediaDataMbS))
{   
    <li class="list-item">
        <div class="list-item__content">
            <span class="list-item__content__text">
                @if (int.TryParse(Model.SocialMediaDataMbS, out var _))
                {
                    @ContentHelper.FormatSize(int.Parse(Model.SocialMediaDataMbS))
                }
                else 
                {
                    @Model.SocialMediaDataMbS;
                }
                @ContentHelper.GetDefaultFrontendLabel(Model, CatalogueAPIfields.SocialMediaDataMbS)
            </span>
        </div>
        <div class="list-item__tooltip"></div>
    </li>
}