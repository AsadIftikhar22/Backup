@using Castle.Core.Internal
@using EPiServer.Cms.WelcomeIntegration.UI.Helpers;
@using Salam.Cms.Shared.Models.Catalogue.Data
@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Catalogue.ViewModels
@using Salam.Cms.Web.Features.Common.Components.Images
@using Salam.Cms.Web.Features.Common.Helpers
@using Salam.Cms.Web.Infrastructure.Extensions
@using static Salam.Cms.Shared.Models.SalamConstants

@model (ProductSku product, FeaturedProductListBlockViewModel viewModel)

@{
    var rawUrl = Model.product.ProductImage != null
        ? Model.product.ProductImage.OriginalString
        : "https://placehold.co/240x240/FFF/B0C1BF";
    var imageUrl = Url.ToProxiedImage(rawUrl);
    // Device device = ContentHelper.GetDevice(Model.product.Id);
}

<div class="featured-product-list__item">
    <div class="featured-card">
        <div class="featured-card__content-wrapper">
            <div class="featured-card__image">
                <img src="@imageUrl" alt="@Model.product.Name" />
            </div>
            <div class="featured-card__content">
                <div class="featured-card__text">
                    <div class="featured-card__title">
                        @Html.PropertyFor(m => m.product.Name)
                    </div>
                    <div class="featured-card__price">
                        @Html.PropertyFor(m => m.product.Price)
                        <span class="featured-card__currency">SAR</span>
                    </div>
                </div>
                @if(!Model.viewModel.HandoffUrl.IsNullOrEmpty() && Model.product?.DeviceIdEncoded != null)
                {
                    <a href="@(Model.viewModel.HandoffUrl + Model.product?.DeviceIdEncoded)" class="icon-button icon-button--primary">
                        <div class="icon-button__arrows">
                            <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2 2L10 10.1096L2.21622 18" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>