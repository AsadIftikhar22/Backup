@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers
@using static Salam.Cms.Shared.Models.SalamConstants

@model ProductSku


@if (Model.DataRollover != null && Model.DataRollover > 0)
{
<li class="list-item">
    <div class="list-item__content">
        <span class="list-item__content__text">
            <strong>
                @if (Model.DataRollover.HasValue)
                {
                    @ContentHelper.FormatSize(Model.DataRollover.Value)
                }
            </strong>
            @ContentHelper.GetDefaultFrontendLabel(Model, CatalogueAPIfields.DataRollover)

        </span>
    </div>
    <div class="list-item__tooltip"></div>
</li>
}