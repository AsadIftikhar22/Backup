@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers
@using static Salam.Cms.Shared.Models.SalamConstants

@model ProductSku

@if (!string.IsNullOrEmpty(Model.CallsMinutes))
{
    <li class="list-item">
        <div class="list-item__content">
            <span class="list-item__content__text">
                <strong>
                    @Model.CallsMinutes
                </strong>
                @{
                    var text = @Model.CallsMinutes.Contains("Unlimited", StringComparison.OrdinalIgnoreCase) ? Model.CallLabel : Model.CallAmountText;
                }
                @text
            </span>
        </div>
        <div class="list-item__tooltip"></div>
    </li>
}