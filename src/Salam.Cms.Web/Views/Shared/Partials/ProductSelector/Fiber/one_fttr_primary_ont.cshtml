@using Salam.Cms.Shared.Models.Catalogue.Data
@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers
@using static Salam.Cms.Shared.Models.SalamConstants

@model ProductSku
@if (!String.IsNullOrEmpty(@Model.one_fttr_primary_ont))
{
    <li class="list-item">
        <div class="list-item__content">
            <span class="list-item__content__text">
                @ContentHelper.GetDefaultFrontendLabel(Model, CatalogueAPIfields.one_fttr_primary_ont)
                <strong>@Model.one_fttr_primary_ont</strong>
            </span>
        </div>
        <div class="list-item__tooltip"></div>
    </li>
}