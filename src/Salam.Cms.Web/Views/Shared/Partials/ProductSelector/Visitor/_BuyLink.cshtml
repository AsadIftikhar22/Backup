@using Castle.Core.Internal
@using Salam.Cms.Shared.Models.Catalogue.Data
@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Common.Helpers

@model (ProductSku item, string? handoffUrl, string? ButtonText)
@{
    bool hasCorrelatedProperty = Model.item != null
        && Model.item.GetType().GetProperty("CorrelatedId") != null;

    bool hasCorrelatedValue = hasCorrelatedProperty
        && !string.IsNullOrEmpty((string?)Model.item?.CorrelatedId);

    bool hasFallback = !string.IsNullOrEmpty(Model.item.BuyButtonRedirection);
}

@if ((hasCorrelatedValue && !Model.handoffUrl.IsNullOrEmpty()) || hasFallback)
{
    <div class="plan-card__footer">
        @{
            var href = hasCorrelatedValue
            ? $"{Model.handoffUrl}{Model.item!.CorrelatedId}"
            : Model.item.BuyButtonRedirection!;
        }
        <a href="@href" class="button button-theme--simple-outlined plan-card__footer-button">
            <span>@Model.ButtonText</span>
            <div class="arrow">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
        </a>
    </div>
}