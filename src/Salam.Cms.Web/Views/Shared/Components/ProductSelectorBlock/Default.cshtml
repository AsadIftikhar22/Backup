@using Castle.Core.Internal
@using NaturalSort.Extension
@using Salam.Cms.Shared.Models
@using Salam.Cms.Shared.Models.Catalogue.Data
@using Salam.Cms.Shared.Models.Catalogue.Enums
@using Salam.Cms.Shared.Models.Catalogue.Models
@using Salam.Cms.Web.Features.Catalogue.ViewModels
@using Salam.Cms.Web.Features.Common.Extensions
@using Salam.Cms.Web.Features.Common.Helpers
@using System.Globalization
@using static Salam.Cms.Shared.Models.SalamConstants

@model ProductSelectorBlockViewModel
<style>
    .flex-row-container {
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;`
        justify-content: flex-start;
        gap: 53px;
    }

    .exclusive-plan-test {
        position: relative;
        margin-top: 24px;
        z-index: 1;
    }

        .exclusive-plan-test::before {
            content: attr(data-label);
            position: absolute;
            top: -32px;
            left: 0;
            width: 100%;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #00d639;
            color: #000;
            font-weight: 500;
            font-size: 14px;
            border-radius: 24px 24px 0 0;
            z-index: -1;
        }
</style>
@{
    string CountryNotes1 = string.Empty; string CountryNotes2 = string.Empty;
    var productTypes = Model.VisibleFields
        .Select(item =>
        {
            var parts = ContentHelper.SplitExtensionForVisibleFields(item);
            return new
            {
                ProductType = parts[0],
                VisibleField = parts.Length > 1 ? parts[1] : string.Empty,
            };
        })
        .GroupBy(x => x.ProductType);

    var productTypesFeatured = Model.VisibleFieldsFeatured?
        .Select(item =>
        {
            var parts = ContentHelper.SplitExtensionForVisibleFields(item);
            return new
            {
                ProductType = parts[0],
                VisibleField = parts.Length > 1 ? parts[1] : string.Empty,
            };
        })
        .GroupBy(x => x.ProductType);

    foreach (var product in Model.Products)
    {
        product.BuyButtonRedirection = Model?.BuyButtonRedirection ?? string.Empty;
    }
}

@if (Model.OverrideProducts.Any())
{
    @await Html.PartialAsync("~/Views/Shared/Partials/ProductSelector/Common/ProductsOverride.cshtml", Model)
    return;
}

@if (Model.Products.Any())
{
    @if (Model.ProductCatalogueCategory.ChildrenData.Count() == 0 || (Model.ProductCatalogueCategory.ChildrenData.Count() > 0 && Model.AreTabsDisabled == true))
    {
        <div class="section-wrapper">
            <div @Html.PageNavigatorAnchorAttribute(Model.NavigationTitle)
                 class="product-selector product-selector__wrapper product-selector__wrapper--bg-light">
                <div class="heading-and-description heading-and-description--secondary">
                    <div class="heading-and-description__title">
                        @Html.PropertyFor(model => model.Title)
                    </div>
                    <div class="heading-and-description__text">

                        @Html.PropertyFor(model => model.Description)
                    </div>
                </div>

                <div class="plan-cards">
                    @{
                        var productTypeSingle = productTypes.First();
                        var prodcutTypeFeaturedSingle = productTypesFeatured?.FirstOrDefault(x => x.Key == productTypeSingle.Key);
                        var comparer = new NaturalSortComparer(StringComparison.OrdinalIgnoreCase);
                    }

                    @foreach (var product in Model.Products.Where(p => p.ProductType == productTypeSingle.Key)
                                .OrderBy(p => p.Name, comparer))
                    {
                        product.Labels = Model.Labels;

                        if (product.IsAddOn.GetValueOrDefault() == true)
                        {
                            string partialUrl = string.Format("~/Views/Shared/Partials/ProductSelector/Common/AddOn.cshtml");
                            var viewModel = new AddOnViewModel()
                            {
                                VisibleFields = productTypeSingle.Select(x => x.VisibleField).ToList(),
                                VisibleFieldsFeatured = prodcutTypeFeaturedSingle?.Select(x => x.VisibleField).ToList() ?? [],
                                ProductType = productTypeSingle.Key,
                                Product = product,
                                Name = product.Name,
                                PlanDetailsText = Model.PlanDetailsText,
                                ProductButtonText = Model.ProductButtonText,
                                PlanDetailsLinks = Model.PlanDetailsLinks.ToList(),
                                HandOffUrl = Model.HandoffUrl,
                                CategoryName = Model.ProductCatalogueCategory.Name,
                                Price = product.PriceString,
                                Validity = product.Validity,
                                Span = Model.Span,
                                VatText = Model.VatText,
                                BuyNowStaticURL=Model?.BuyNowStaticURL
                            };
                            @await Html.PartialAsync(partialUrl, viewModel)
                        }
                        else
                        {
                            <div class="plan-card-sudo-tag @(product.exclusive == true ? "exclusive-plan-test" : "")"
                                 data-label="@(product.exclusive == true ? @Model.CurrentBlock?.ExclusiveText : "")">
                                <div class="plan-card-wrapper">
                                    <div class="plan-card">
                                        <p class="plan-card__heading">
                                            @product.Name
                                        </p>
                                        @if (product.SpecialPrice > 0)
                                        {
                                            <span class="old-price">
                                                <span class="old-price-amount">@product.Price.ToString("0.##", CultureInfo.InvariantCulture)</span>
                                                <span class="old-price-text plan-card__price-pm">
                                                    @Model.DiscountedPriceSpan
                                                </span>
                                            </span>
                                            <div class="plan-card__header">
                                                <h3 class="plan-card__price">@product.SpecialPrice?.ToString("0.##", CultureInfo.InvariantCulture)</h3>
                                                @if (!string.IsNullOrEmpty(Model.Span))
                                                {
                                                    <div class="plan-card__price-pm">
                                                        @Model.Span @product.Validity
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="plan-card__header">
                                                <h3 class="plan-card__price">@product.Price.ToString("0.##", CultureInfo.InvariantCulture)</h3>
                                                @if (!string.IsNullOrEmpty(Model.Span))
                                                {
                                                    <div class="plan-card__price-pm">
                                                        @Model.Span @product.Validity
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.VatText))
                                        {
                                            <div class="plan-card__vat">
                                                @Model.VatText
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(Model.BadgeText) && (!string.IsNullOrEmpty(product.FreeTime) || !string.IsNullOrEmpty(product.PackageDuration)))
                                        {
                                            var badgeText = Model.BadgeText
                                            .Replace("[[FreeTime]]", product.FreeTime)
                                            .Replace("[[PackageDuration]]", product.PackageDuration);

                                            <div class="chips chips--primary plan-card__chip">
                                                <span class="chips__text">@badgeText</span>
                                            </div>
                                        }
                                        else if (prodcutTypeFeaturedSingle != null && prodcutTypeFeaturedSingle.Any())
                                        {
                                            @await Html.PartialAsync("~/Views/Shared/Partials/ProductSelector/Common/_FeaturedVisibleFields.cshtml", (prodcutTypeFeaturedSingle.Cast<object>(), product as ProductSku))
                                        }
                                        else
                                        {
                                            @* <div class="plan-card__divider"></div>  *@
                                        }

                                        <ul class="plan-card__items">
                                            @foreach (var field in productTypeSingle)
                                            {
                                                string partialUrl = string.Format("~/Views/Shared/Partials/ProductSelector/Common/{0}.cshtml", field.VisibleField);
                                                @await Html.PartialAsync(partialUrl, product as ProductSku)
                                            }
                                        </ul>
                                    </div>
                                    <div class="plan-card__footer">
                                        @{
                                            var planDetails = Model.PlanDetailsLinks
                                            .FirstOrDefault(planDetail => planDetail.ProductId == product.Id);

                                        }
                                        @if (planDetails != null)
                                        {
                                            <a href="@Url.ContentUrl(planDetails.PlanDetailsUrl)" class="button button-theme--transparent-primary">
                                                <span>@Model.PlanDetailsText</span>
                                                <div class="arrow">
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </div>
                                            </a>
                                        }

                                        @{
                                            string buyNowPartialView = string.Format("~/Views/Shared/Partials/ProductSelector/{0}/_BuyLink.cshtml", productTypeSingle.Key);
                                            @await Html.PartialAsync(buyNowPartialView, (product as ProductSku, Model.HandoffUrl, Model?.ProductButtonText))
                                            ;
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (!Model.IsFooterDisabled)
                {
                    @if (!Model.ShowFlags)
                    {
                        @await Html.PartialAsync("~/Views/Shared/Partials/SocialLinkIcons.cshtml", new { FooterText = @Model.FooterText })
                    }
                    else
                    {
                        @await Html.PartialAsync("~/Views/Shared/Partials/CountryIcons.cshtml", new { FooterText = @Model.FooterText })
                    }
                }
            </div>
        </div>
    }


    @if (Model.ProductCatalogueCategory.ChildrenData.Count() >= 1 && Model.AreTabsDisabled == false)
    {
        <div class="section-wrapper">
            <div @Html.PageNavigatorAnchorAttribute(Model.NavigationTitle)
                 class="product-selector product-selector__wrapper product-selector__wrapper--bg-light">
                <div class="heading-and-description heading-and-description--secondary">
                    <div class="heading-and-description__title">
                        @Html.PropertyFor(m => m.Title)
                    </div>
                    <p class="heading-and-description__text">
                        @Html.PropertyFor(model => model.Description)
                    </p>
                </div>
                <nav class="tabs-navigation @(Model.IsMultipleTabNavigation ? "tabs-navigation--multiple" : string.Empty)">
                    <div class="tabs-navigation__labels-wrapper">
                        <div class="tabs-navigation__labels">
                            @{
                                var tabNumber = 1;
                                var tabCategoryDict = new Dictionary<int, int>();
                            }
                            @foreach (var categoryType in Model.ProductCatalogueCategory.ChildrenData.OrderBy(x=>x.Name))
                            {
                                tabCategoryDict.Add(tabNumber, categoryType.Id);

                                <button class="tab-label @(tabNumber == 1 ? "active" : string.Empty)"
                                        data-tab-target="tab@(tabNumber)">
                                    @categoryType.Name
                                </button>
                                tabNumber++;
                            }
                        </div>
                    </div>
                    <div class="tabs-navigation__content">
                        @{
                            var tabContentNumber = 1;
                            var products = Model.Products.Where(x => x.CategoryIds.Contains(tabCategoryDict.Single(x => x.Key == tabContentNumber).Value));
                        }
                        @foreach (var category in Model.ProductCatalogueCategory.ChildrenData)
                        {
                            <div class="tab-content active flex-row-container" id="tab@(tabContentNumber)">
                                <div class="plan-cards">
                                    @foreach (var product in products)
                                    {
                                        product.Labels = Model.Labels;

                                        var productType = productTypes.FirstOrDefault(x => x.Key == product.ProductType);

                                        if (product.IsAddOn.GetValueOrDefault() == true)
                                        {
                                            string partialUrl = string.Format("~/Views/Shared/Partials/ProductSelector/Common/AddOn.cshtml");
                                            var viewModel = new AddOnViewModel()
                                            {
                                                VisibleFields = productType.Select(x => x.VisibleField).ToList(),
                                                VisibleFieldsFeatured = productType.Select(x => x.VisibleField).ToList(),
                                                ProductType = productType.Key,
                                                Product = product,
                                                Name = product.Name,
                                                PlanDetailsText = Model.PlanDetailsText,
                                                ProductButtonText = Model.ProductButtonText,
                                                PlanDetailsLinks = Model.PlanDetailsLinks.ToList(),
                                                HandOffUrl = Model.HandoffUrl,
                                                CategoryName = Model.ProductCatalogueCategory.Name,
                                                Price = product.PriceString,
                                                Validity = product.Validity,
                                                DataText = Model.DataText,
                                                CallLabel = Model.CallLabel,
                                                CallAmountText = Model.CallAmountText,
                                                BuyNowStaticURL = Model?.BuyNowStaticURL
                                            };
                                            @await Html.PartialAsync(partialUrl, viewModel)
                                        }
                                        else
                                        {
                                            var productTypeSingle = productTypes.Single(x => x.Key == product.ProductType);
                                            var prodcutTypeFeaturedSingle = productTypesFeatured?.FirstOrDefault(x => x.Key == productTypeSingle.Key);

                                            <div class="plan-card-wrapper">
                                                <div class="plan-card">
                                                    <p class="plan-card__heading">
                                                        @product.Name
                                                    </p>
                                                    @if (product.SpecialPrice > 0)
                                                    {
                                                        <span class="old-price">
                                                            <span class="old-price-amount">@product.Price.ToString("0.##", CultureInfo.InvariantCulture)</span>
                                                            <span class="old-price-text plan-card__price-pm">
                                                                @Model.Span
                                                            </span>
                                                        </span>
                                                        <div class="plan-card__header">
                                                            <h3 class="plan-card__price">@product.SpecialPrice?.ToString("0.##", CultureInfo.InvariantCulture)</h3>
                                                            @if (!string.IsNullOrEmpty(Model.Span))
                                                            {
                                                                <div class="plan-card__price-pm">
                                                                    @Model.Span @product.Validity
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="plan-card__header">
                                                            <h3 class="plan-card__price">@product.Price.ToString("0.##", CultureInfo.InvariantCulture)</h3>
                                                            @if (!string.IsNullOrEmpty(Model.Span))
                                                            {
                                                                <div class="plan-card__price-pm">
                                                                    @Model.Span @product.Validity
                                                                </div>
                                                            }
                                                        </div>
                                                    }


                                                    @if (!string.IsNullOrEmpty(Model.VatText))
                                                    {
                                                        <div class="plan-card__vat">
                                                            @Model.VatText
                                                        </div>
                                                    }

                                                    @if (!string.IsNullOrEmpty(Model.BadgeText) && (!string.IsNullOrEmpty(product.FreeTime) || !string.IsNullOrEmpty(product.PackageDuration)))
                                                    {
                                                        var badgeText = Model.BadgeText
                                                        .Replace("[[FreeTime]]", product.FreeTime)
                                                        .Replace("[[PackageDuration]]", product.PackageDuration);

                                                        <div class="chips chips--primary plan-card__chip">
                                                            <span class="chips__text">@badgeText</span>
                                                        </div>
                                                    }
                                                    else if (prodcutTypeFeaturedSingle != null && prodcutTypeFeaturedSingle.Any())
                                                    {
                                                        @await Html.PartialAsync("~/Views/Shared/Partials/ProductSelector/Common/_FeaturedVisibleFields.cshtml", (prodcutTypeFeaturedSingle.Cast<object>(), product as ProductSku))
                                                    }
                                                    else
                                                    {
                                                        @* <div class="plan-card__divider"></div>  *@
                                                    }

                                                    <ul class="plan-card__items">
                                                        @foreach (var field in productType)
                                                        {

                                                            string partialUrl = string.Format("~/Views/Shared/Partials/ProductSelector/Common/{0}.cshtml", field.VisibleField);
                                                            @await Html.PartialAsync(partialUrl, product as ProductSku)
                                                        }
                                                    </ul>
                                                </div>
                                                <div class="plan-card__footer">
                                                    @{
                                                        var planDetails = Model.PlanDetailsLinks
                                                        .FirstOrDefault(planDetail => planDetail.ProductId == product.Id);
                                                    }
                                                    @if (planDetails != null)
                                                    {
                                                        <a href="@Url.ContentUrl(planDetails.PlanDetailsUrl)" class="button button-theme--transparent-primary">
                                                            <span>@Model.PlanDetailsText</span>
                                                            <div class="arrow">
                                                                <span></span>
                                                                <span></span>
                                                                <span></span>
                                                                <span></span>
                                                                <span></span>
                                                            </div>
                                                        </a>
                                                    }
                                                    @{
                                                        string buyNowPartialView = string.Format("~/Views/Shared/Partials/ProductSelector/{0}/_BuyLink.cshtml", productType.Key);
                                                        @await Html.PartialAsync(buyNowPartialView, (product as ProductSku, Model.HandoffUrl, Model?.ProductButtonText))
                                                    }
                                                    @if (!String.IsNullOrEmpty(product.country_notes_1))
                                                    {
                                                        CountryNotes1 = product.country_notes_1;
                                                    }
                                                    @if (!String.IsNullOrEmpty(product.country_notes_2))
                                                    {
                                                        CountryNotes2 = product.country_notes_2;
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                @if (!String.IsNullOrEmpty(CountryNotes1) || !String.IsNullOrEmpty(CountryNotes2))
                                {
                                    <div style="display: block;">
                                        if()
                                        <p>@CountryNotes1</p>
                                        <p>@CountryNotes2</p>
                                    </div>
                                }
                                @if (category.Name.ToLower() == "pakistan")
                                {
                                    <div style="color: green; margin-left: 12px;">
                                        <p> * Ufone, Zong, Jazz/Warid , ** All networks</p>
                                    </div>
                                }
                            </div>
                            tabContentNumber++;
                        }
                    </div>
                </nav>
                @if (!Model.IsFooterDisabled)
                {
                    @if (!Model.ShowFlags)
                    {
                        @await Html.PartialAsync("~/Views/Shared/Partials/SocialLinkIcons.cshtml", new { FooterText = @Model.FooterText })
                    }
                    else
                    {
                        @await Html.PartialAsync("~/Views/Shared/Partials/CountryIcons.cshtml", new { FooterText = @Model.FooterText })
                    }
                }
            </div>
        </div>
    }
}
