                <div class="fraud-modal-textarea" id="ratingFeedback" style="display:none;">
                    <label>@Model?.ProtectorChannelModelElementBlock?.RatingFeedbackLabel</label>
                    <textarea name="ratingDetails"
                              rows="4"
