                </div>

                <button type="button" class="fraud-modal-btn">@Model?.ProtectorChannelModelElementBlock?.FraudModelBtnText</button>
            </div>
        </div>
    </div>
</div>


<div class="fraud-modal-wrapper" id="success-modal">
    <div class="fraud-modal-overlay">
        <div class="fraud-modal-box">
            <div class="fraud-modal-close">&times;</div>
            <div class="success-container">
                <div class="success-header">
                    <img src="https://staging-mobile.salammobile.sa/wp-content/uploads/2025/05/Status.png.webp" />
                    <div class="success-body">
                        <h1>@Model?.SuccessMessageTxt</h1>
                        <p>@Model?.SuccessMessageDescp</p>
                        @if (LinkItemExtensions.IsValid(Model?.SuccessHomePageUrl))
                        {
                            <a href="@Url.ContentUrl(Model?.SuccessHomePageUrl?.Href)" title="@Model?.SuccessHomePageUrl?.Title" target="@Model?.SuccessHomePageUrl?.Target"
                               class="home-btn">@Model?.SuccessHomePageUrl?.Text</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="success-view">
    <section class="success-section">
        <div class="top-bg"></div>
        <div class="content">
            <img src="https://staging-mobile.salammobile.sa/wp-content/uploads/2023/10/absherVerified.svg"
                 alt="Success"
                 class="success-img" />
            <h1>@Model?.SuccessMessagePageTxt</h1>
            @Html.Raw(Model?.SuccessMessagePageDescp)
            @if (LinkItemExtensions.IsValid(Model?.SuccessHomePageUrl))
            {
                <button href="@Url.ContentUrl(Model?.SuccessHomePageUrl?.Href)" title="@Model?.SuccessHomePageUrl?.Title" target="@Model?.SuccessHomePageUrl?.Target"
                        class="btn">
                    @Model?.SuccessHomePageUrl?.Text
                </button>
            }
        </div>
    </section>
</div>
<div id="formLoader" class="loader-overlay">
    <div class="loader"></div>
</div>
<script>
       document.addEventListener("DOMContentLoaded", function (e) {
        sessionStorage.clear();
       if (typeof epi !== 'undefined' && epi.EPiServer.Forms) {
            console.log("Form JS Enabled");
            epi.EPiServer.Forms.AsyncSubmit = true;
       }

       MobilePhoneOTPValidation();
       const form = document.querySelector(".EPiServerForms");
       if (!form) return;
        function updateNextButtonText() {

               const nextBtn = document.querySelector(".Form__NavigationBar .btnNext");
               if (!nextBtn) return;
               const activeStep = document.querySelector('.FormStep:not(.hide)');
               if (!activeStep) return;
               const btnText = activeStep.dataset.btnText;
               if (btnText && btnText.trim() !== "") {
                   nextBtn.innerText = btnText;
           }
       }

       updateNextButtonText();
           if (typeof $$epiforms !== 'undefined') {

        $$epiforms('.EPiServerForms')
            .on('formsStartSubmitting', function () {
                showLoader();
            }).on('formsSubmitted', function () {
                hideLoader();
            }).on('formsSubmittedError', function () {
                      hideLoader();
            });
    }
       $$epiforms('.EPiServerForms')
               .on('formsNavigateToStep afterNavigateNextStep formsStepValidating', function () {
                   setTimeout(updateNextButtonText, 50);
       });
       const wrapper = document.querySelector('.fraud-modal-wrapper');
       const successModal = document.getElementById('success-modal');
       const closeBtn = successModal.querySelector('.fraud-modal-close');
       const modalOverlay = document.querySelector('.fraud-modal-overlay');
       const ModalSubmitBtn=document.querySelector('.fraud-modal-btn');
       const SuccessPageContent=document.getElementById('success-view');
       wrapper.style.display = "none";
       modalOverlay.querySelector(".fraud-modal-close")
           ?.addEventListener("click", hideModal);
       modalOverlay.addEventListener("click", e => {
           if (e.target === modalOverlay) {
           hideModal();
           hideLoader();
           }
       });
       function showModal() {
           document.querySelector('.fraud-modal-wrapper').style.display = "block";

       }

       function hideModal() {
           document.querySelector('.fraud-modal-wrapper').style.display = "none";
           hideLoader();
       }
       function showLoader(){
              const loader = document.getElementById("formLoader");
                if (loader) loader.style.display = "flex";
       }

       function hideLoader(){
              const loader = document.getElementById("formLoader");
                if (loader) loader.style.display = "none";
       }

       let modalConfirmed = false;

        function getModalValues() {
            const selectedRating = document.querySelector(
                   '.fraud-modal-option input[type="radio"]:checked'
            );

            return {
                   rating: selectedRating ? selectedRating.value : ""
            };
        }
            document.addEventListener("keydown", function (e) {
                  if (e.code === "Enter") {
                         updateMobileNumberText();
                  }
                    showLoader();
                    const visibleStep = document.querySelector("section.FormStep:not(.hide)");
                    if (!visibleStep) return;
                    const stepIndex = parseInt(visibleStep.dataset.fStepindex, 10);
                       if (stepIndex === 2 && !modalConfirmed && e.code === "Enter") {
                            e.preventDefault();
                            e.stopImmediatePropagation();
                            showModal();

                       }
                    hideLoader();
                 // }
            }, true);

            document.addEventListener("click", function (e) {
                   updateMobileNumberText();
            });

            function updateMobileNumberText(){
                const mobileField = document.querySelector("input.mobilenumber");
                if (mobileField?.value !== null && mobileField?.value !== "" && mobileField?.value.length >9) {
                       let el = document.getElementById("mobilenumber");
                       let currentText = el.innerText;
                       let updatedText = currentText.replace('MobileNumber', mobileField?.value );
                       el.innerText = updatedText;
                }
           }

           document.addEventListener("click", function (e) {
           const btn = e.target.closest("button[data-f-navigation-next]");
           if (!btn) return;
           const visibleStep = document.querySelector("section.FormStep:not(.hide)");
           if (!visibleStep) return;
           const stepIndex = parseInt(visibleStep.dataset.fStepindex, 10);
           if(stepIndex == 0){
               updateMobileNumberText();
           }
           if (stepIndex === 2 && !modalConfirmed) {
               showLoader();
               e.preventDefault();
               e.stopImmediatePropagation();
               var isDuplicate = MobilePhoneComparison();
               var isInvalidPhone = MobilePhoneValidation();
               if(isDuplicate || isInvalidPhone){
                   return;
               }
               showModal();
               hideLoader();
           }
       }, true);

       function MobilePhoneComparison(){
            const blocks = document.querySelectorAll(".b2bnumberelementblock");
            const values = [];

            blocks.forEach(block => {
                    const input = block.querySelector("input[type='text']");
                  if (input) {
                        values.push(input.value.trim());
                  }
            });
            const uniqueValues = [...new Set(values)];

            if (uniqueValues.length < values.length) {
                    alert("The Reported Identity and Reported Number could not be same");
                    return true;
            }
            return false;
       }

       function MobilePhoneOTPValidation(){
                const inputs = document.querySelectorAll(".mobilenumber");
                inputs.forEach(input => {
                  input.addEventListener("input", () => {
                    const value = input.value.trim();
                    const patternText = input.pattern;
                    const regex = new RegExp(patternText);

                        // Get the outer error container
                        const outerError = input.nextElementSibling;
                        // Get the inner error span inside it
                        const innerError = outerError?.querySelector(".Form__Element__ValidationError");

                        if (value.length === 10 && !regex.test(value)) {
                            // Show the outer span
                            if (outerError) {
                                document.querySelector('.error-message').style.removeProperty("display")
                            }
                            // Add your error text
                            if (innerError) {
                                innerError.textContent = "Please enter number in valid format";
                                innerError.classList.remove("hidden");
                            }
                        } else {
                            // Clear outer and inner
                            if (outerError) {
                                outerError.style.display = "none"; // hide it
                            }
                            if (innerError) {
                                innerError.textContent = "";
                                innerError.classList.add("hidden");
                            }
                        }
                    });
                });
       }

       function MobilePhoneValidation() {
        setTimeout(showLoader, 20);
        let valid = false;

        let senderMobileWrapper = document.querySelector('.sender-mobile');
        let callerMobileWrapper = document.querySelector('.caller-mobile');
        let internationalMobileWrapper = document.querySelector('.international-sender-mobile');
        let localLandlineNumberWrapper = document.querySelector('.local-landline-sender-mobile');

        // Sender Mobile
        if (senderMobileWrapper) {
            const number = (senderMobileWrapper.value || '').trim();

            if (!number.startsWith('0') || number.length !== 10) {
                showError(senderMobileWrapper, 'Oops, you entered the wrong number');
                valid = true;
            } else {
                hideError(senderMobileWrapper);
            }
        }

        // Caller Mobile
        if (callerMobileWrapper) {
            const number = (callerMobileWrapper.value || '').trim();

            if (!number.startsWith('0') || number.length !== 10) {
                showError(callerMobileWrapper, 'Oops, you entered the wrong number');
                valid = true;
            } else {
                hideError(callerMobileWrapper);
            }
        }

        // International Sender Mobile
        if (internationalMobileWrapper) {
            const number = (internationalMobileWrapper.value || '').trim();

            if (!number.startsWith('00') || number.length < 12) {
                showError(internationalMobileWrapper, 'Oops, you entered the wrong number');
                valid = true;
            } else {
                hideError(internationalMobileWrapper);
            }
        }

        // Local Landline
        if (localLandlineNumberWrapper) {
            const number = (localLandlineNumberWrapper.value || '').trim().replace(/\s/g, '');

            if (!number.startsWith('01') || number.length !== 10) {
                showError(localLandlineNumberWrapper, 'Oops, you entered the wrong number');
                valid = true;
            } else {
                hideError(localLandlineNumberWrapper);
            }
        }
        setTimeout(hideLoader, 20);
        return valid;
    }

        function showError(wrapper, message) {
            if (!wrapper) return;
            const forField = wrapper.closest('.form-field');
                if (forField) {
                    const errorWrapper = forField.querySelector('.error-message');
                    const errorText = forField.querySelector('.Form__Element__ValidationError');
                    if (errorWrapper && errorText) {
                        errorText.textContent = message;
                        errorText.classList.remove('hidden');
                        errorWrapper.style.display = 'block';
                    }
                }
        }

        function hideError(wrapper) {

            if (!wrapper) return;

            const forField = wrapper.closest('.form-field');
            if (forField) {
                const errorWrapper = forField.querySelector('.error-message');
                const errorText = forField.querySelector('.Form__Element__ValidationError');
                if (errorWrapper && errorText) {
                    errorText.textContent = '';
                    errorText.classList.add('hidden');
                    errorWrapper.style.display = 'none';
                }
            }
            hideLoader();
        }

        document.querySelectorAll('input[name="rating"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                var selectedValue = parseInt(this.value);
                if (selectedValue === 3 || selectedValue === 4 || selectedValue === 5) {
                    document.getElementById("ratingFeedback").style.display = "block";
                } else {
                    document.getElementById("ratingFeedback").style.display = "none";
                }
            });
         });


        if (typeof $$epiforms !== "undefined") {
            $$epiforms(".EPiServerForms").on("formsSubmitted", function (event, data) {
            const visibleStep = document.querySelector("section.FormStep:not(.hide)");
            if (!visibleStep) return;
            const stepIndex = parseInt(visibleStep.dataset.fStepindex, 10);
                if (event.isSuccess && stepIndex==2) {
                setTimeout(showLoader, 20);
                const formContainer = document.querySelector(".EPiServerForms");
                if (formContainer) {
                    formContainer.style.display = "none";
                }
                 successModal.style.display = "block";
                 successPageContent.style.display = "block";
                }
                modalConfirmed=false;
                hideLoader();
            });
        }
            closeBtn.addEventListener("click", closeSuccessModal);
            function closeSuccessModal() {
                successModal.style.display = "none";
                hideLoader();
            }


       ModalSubmitBtn.addEventListener("click", function () {
        showLoader();
        modalConfirmed = true;
        hideModal();
        const modal = getModalValues();
        const subCategory = document.querySelector("select[name='SubCategory']");
        const typeOfComplaint = subCategory?.selectedOptions[0]?.dataset.typeofcomplaint;
        const textArea = document.querySelector(".SMS")?.value;
        // const numberValue = document.querySelector(".MobileNumber")?.value.trim();
        const numberValue =Array.from(document.querySelectorAll("input.MobileNumber"))
                            .map(i => i.value.trim())
                            .find(v => v !== "") || "";
        const ratingDetails=document.querySelector('textarea[name="ratingDetails"]')?.value;
        const ratingField = document.querySelector(".ModalRatingHdnField");
        const subCategoryField = document.querySelector(".SubCategoryHdnField");
        const MobileNumField = document.querySelector(".MobileHdnField");
        const feedBackField = document.querySelector(".FeedbackHdnField");
        const ratingHdnDetails = document.querySelector(".ratingHdnDetails");

        if (ratingField) ratingField.value = modal.rating || "";
        if (subCategoryField) subCategoryField.value = typeOfComplaint || "";
        if (textArea) feedBackField.value = textArea|| "";
        if(numberValue) MobileNumField.value = numberValue || "";
        if(ratingDetails) ratingHdnDetails.value=ratingDetails||"";
        setTimeout(() => {
                    const nextBtn = document.querySelector(".EPiServerForms button[data-f-navigation-next]");
                    if (nextBtn) nextBtn.click();

            }, 50);
       hideLoader();
       });
    });
</script>
