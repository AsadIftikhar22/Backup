@model Salam.Cms.Web.Features.Common.Components.MetaData.MetaDataViewModel

<title>@Model.Title</title>
<meta name="description" content="@Model.Description" />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="ie=edge" />

@* @if (!string.IsNullOrWhiteSpace(Model.Robots))
{ *@
<meta name="robots" content="index, follow" />
@* } *@

@if (Model.PublishedDateTime != null)
{
    <meta property="article:published_time" content="@Model.PublishedDateTime" />
}
@if (Model.ModifiedDateTime != null)
{
    <meta property="article:modified_time" content="@Model.ModifiedDateTime" />
}
@if (Model.ExpirationDateTime != null)
{
    <meta property="article:expiration_time" content="@Model.ExpirationDateTime" />
}
@if (!Model.Categories.IsNullOrEmpty())
{
    @foreach (var category in Model.Categories)
    {
        <meta property="article:category" content="@category" />
    }
}

@{
    var canonicalLink = Url.AbsoluteUrl(Model.CanonicalLink);

    if (Model.HasCategoryRouting)
    {
        if (Model.RelativeCategoryUrl != null)
        {
            canonicalLink = Url.AbsoluteUrl(Model.RelativeCategoryUrl);
        }
    }
    // if (Model.HasPagination)
    // {
    //     canonicalLink += $"{Context.Request.QueryString}";
    // }
}
@* <link rel="canonical" href="@canonicalLink" /> *@
<link rel="canonical" href="@Model.CanonicalUrl" />

<!-- Favicon -->
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" href="/favicon/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon/favicon-16x16.png" sizes="16x16" />
<link rel="mask-icon" href="/favicon/favicon.svg" />
<link rel="shortcut icon" href="/favicon/favicon.ico" />
<meta name="msapplication-config" content="/favicon/browserconfig.xml" />

@if (Model.RenderAlternativeLinks)
{
    if (Model.UsingAlternativeCanonicalLink)
    {
        @Html.AlternateLinks(Model.CanonicalLink, "Index")
        ;
    }
    else
    {
        @Html.AlternateLinks(Model.ContentLink, Model.Action)
        ;
    }
}
