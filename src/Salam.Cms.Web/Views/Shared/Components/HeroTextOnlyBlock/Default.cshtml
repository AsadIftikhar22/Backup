@using Salam.Cms.Web.Features.Hero.ViewModels

@model HeroTextOnlyBlockViewModel

<div class="section-wrapper">
<div class="hero-text-only-block">
    <div class="page-header">
        <h1 class="page-header__heading">
            @Html.PropertyFor(m => m.CurrentBlock.Heading)
        </h1>
        <div class="page-header__description">
            @Html.XhtmlString(Model.CurrentBlock.Description)
        </div>
    </div>
</div>
</div>