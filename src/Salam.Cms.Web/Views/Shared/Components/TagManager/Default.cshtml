@model Salam.Cms.Web.Features.Common.Components.TagManager.TagManagerViewModel

@if (Model.DataLayer != null)
{
    <script>
        dataLayer = [@Html.Raw(Model.DataLayer.ToJson())];
    </script>
}
else
{
    <script>dataLayer = [];</script>
}

@if (!string.IsNullOrWhiteSpace(Model.TagManagerKey))
{
    <script>
        (function(w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                'gtm.start':
                    new Date().getTime(),
                event: 'gtm.js'
            });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src =
                'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', '@Model.TagManagerKey');
    </script>
}