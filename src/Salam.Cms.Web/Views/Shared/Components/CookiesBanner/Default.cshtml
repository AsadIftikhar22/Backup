


@using Salam.Cms.Web.Features.Showcase.ViewModels
@model CookiesBannerViewModel
@{
    bool AllowAnalytics = Context.Request.Cookies["Analytics"] != null
        ? (Context.Request.Cookies["Analytics"] == "true")
        : true;

    bool AllowMarketing = Context.Request.Cookies["Marketing"] != null
        ? (Context.Request.Cookies["Marketing"] == "true")
        : true;

}
