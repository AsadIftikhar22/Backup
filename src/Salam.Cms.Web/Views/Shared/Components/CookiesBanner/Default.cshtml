            </svg>
        </div>
        <span class="cookie-title">@Model.PreferencesHeading</span>
    </div>

    <div class="cookie-option">
        <div class="cookie-option-header">
            <label>
                <input type="checkbox" checked disabled />
                <span>
                    @Model.EssentialCookiesTitle
                    <span style="color:#00cc44;">(@Model.EssentialCookiesSubTitle)</span>
                </span>
            </label>
            <small>@Model.EssentialCookiesDescription</small>
        </div>
    </div>

    <div class="cookie-option">
        <div class="cookie-option-header">
            <label>
                <input type="checkbox" id="analytics" @(AllowAnalytics ? "checked" : "") />
                <span>@Model.AnalyticsCookiesTitle</span>
            </label>
            <small>@Model.AnalyticsCookiesDescription</small>
        </div>
    </div>

    <div class="cookie-option">
        <div class="cookie-option-header">
            <label>
                <input type="checkbox" id="marketing" @(AllowMarketing ? "checked" : "") />
                <span>@Model.MarketingCookiesTitle</span>
            </label>
            <small>@Model.MarketingCookiesDescription</small>
        </div>
    </div>

    <div class="buttons">
        <button type="button" class="reject">@Model.RejectAllPreferencesText</button>
        <button type="button" class="save">@Model.SavePreferencesText</button>
        <button type="button" class="accept">@Model.AcceptAllPreferencesText</button>
    </div>
</div>
