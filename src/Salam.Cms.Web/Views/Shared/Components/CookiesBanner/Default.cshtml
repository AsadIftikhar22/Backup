        <span class="cookie-title">@Model.CookieBannerHeading</span>
    </div>

    <p class="cookie-text">
        @Model.CookieBannerDescription
    </p>

    <div class="cookie-buttons">
        <button type="button" class="reject-btn">@Model.RejectButtonText</button>
        <button type="button" class="customize-btn">@Model.CustomizeButtonText</button>
        <button type="button" class="accept-btn">@Model.AcceptButtonText</button>
    </div>
