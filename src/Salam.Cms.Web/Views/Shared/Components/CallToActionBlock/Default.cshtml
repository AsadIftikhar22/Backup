@using Salam.Cms.Web.Features.CallToAction.ViewModels
@using Salam.Cms.Web.Features.Common.Components.Images
@using Salam.Cms.Web.Features.Common.Extensions
@using PictureRenderer
@using PictureRenderer.Profiles

@model CallToActionBlockViewModel

<div class="section-wrapper">
<div @Html.PageNavigatorAnchorAttribute(Model.CurrentBlock.NavigationTitle) class="cta-block cta-block--large">
    <div class="cta-block__content">
        <div class="cta-block__content__details">
            @if (!string.IsNullOrEmpty(Model.CurrentBlock.BadgeText))
            {
                <div class="chips">
                    <span class="chips__text">
                        @Html.PropertyFor(m => m.CurrentBlock.BadgeText)
                    </span>
                </div>
            }            
            <h3>
                @Html.PropertyFor(m => m.CurrentBlock.HeadingLineOne) 
                <span>@Html.PropertyFor(m => m.CurrentBlock.HeadingLineTwo)</span>
            </h3>
            @Html.PropertyFor(m => m.CurrentBlock.MainBody)
        </div>
        @await Html.PartialAsync("~/Views/Shared/Components/CallToActionBlock/LinkItems.cshtml", Model.CurrentBlock.LinkItems)
    </div>
    @if (Model.CurrentBlock.Media != null)
    {
        <div class="cta-block__image">
            @await Html.Picture(Model.CurrentBlock.Media,
            PictureProfiles.CTA, new PictureAttributes
            {
                LazyLoading = LazyLoading.Browser,
                ImgDecoding = ImageDecoding.Sync,
                ImgFetchPriority = FetchPriority.Low
            })
