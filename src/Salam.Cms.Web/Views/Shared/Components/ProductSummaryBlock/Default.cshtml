                    </div>
                    <div class="plan-card-banner__content">
                        <p class="plan-card-banner__heading">@Model.Product?.Name</p>
                        @if (Model.Product.SpecialPrice > 0)
                        { 
                            <span class="old-price">
                                <span class="old-price-amount">@Model.Product.Price.ToString("0.##", CultureInfo.InvariantCulture)</span>
                                <span class="old-price-text plan-card-banner__price-pm">
                                    @Model.DiscountedPriceSpan
                                </span>
                            </span>
                        }
                        <h2 class="plan-card-banner__price" style="font-size:56px; line-height:56px;">
                            @if (Model.Product.SpecialPrice > 0)
                            {
                                @Model.Product?.SpecialPrice?.ToString("0.##", CultureInfo.InvariantCulture)
                            }
                            else
                            {
                                @Model.Product?.Price.ToString("0.##", CultureInfo.InvariantCulture)
                            }
                        </h2>
                        @if (!string.IsNullOrEmpty(Model.Span) || !string.IsNullOrEmpty(Model.Product?.Validity))
                        {
                            <p class="plan-card-banner__price-pm">
                                @Model.Span @Model.Product.Validity
                            </p>

                        }
                        <p class="plan-card-banner__vat">@Model.VatText</p>
                    </div>
                    @{
                        string buyNowPartialView = string.Format("~/Views/Shared/Partials/ProductSummary/{0}/_BuyLink.cshtml", productType?.Key);
                        @await Html.PartialAsync(buyNowPartialView, (Model.Product as ProductSku, Model.HandoffUrl, Model.ProductButtonText))
                    }
                </div>
            </div>
            <div class="product-summary__right">
