@using EPiServer.Framework.ClientResources
@using EPiServer.ServiceLocation
@using EPiServer.Forms
@using EPiServer.Forms.Core
@using EPiServer.Forms.Core.Internal
@using EPiServer.Forms.Helpers.Internal
@using EPiServer.Forms.EditView.Internal
@using EPiServer.Forms.Implementation.Elements
@using EPiServer.Web.Mvc.Html
@using EPiServer.Web
@using EPiServer.Shell.Web.Mvc.Html
@using EPiServer.Web.Routing
@using Salam.Cms.Web.Features.ConnectivityRemove.Components
@using Salam.Cms.Web.Features.Forms.B2BFormContainerBlock
@using Salam.Cms.Web.Infrastructure.Forms.Services
@using EPiServer.Core
@using EPiServer.Web.Routing

@model B2BFormContainerBlock
@inject UrlResolver UrlResolver
@{
    var dataSubmissionService = ServiceLocator.Current.GetInstance<ProtectorChannelFormDataSubmissionService>();
    var readOnlyModeMessage = dataSubmissionService.GetReadOnlyModeMessage();
    var currentMode = ServiceLocator.Current.GetInstance<IContextModeResolver>().CurrentMode;
    var formTitleId = Model.Form.FormGuid + "_label";
    var _cspNonceService = ServiceLocator.Current.GetInstance<ICspNonceService>();
    var nonceAttribute = string.IsNullOrEmpty(_cspNonceService.GetNonce()) ? "" : $"nonce = \"{_cspNonceService.GetNonce()}\"";

    var bgColor = Model.SelectedHexColor;
    var headingFontSize = Model.HeadingFontSize;
    var headingFontWeight = Model.HeadingFontWeight;
    var MobileheadingFontSize = Model.MobileHeadingFontSize ?? "35px";
    var MobileheadingFontWeight = Model.MobileHeadingFontWeight ?? "400";
    var paragraphFontSize = Model.ParagraphFontSize;
    var MobileParagraphFontSize = Model.MobileParagraphFontSize ?? "16px";
    var formWidth = Model.FormWidth ?? "676px";
    ViewBag.SubmitMessage = Model.SubmitSuccessMessage;
    var LabelFormFontColor = Model.LabelFormColor ?? "#2e7d32";
    var LabelFormFontSize = Model.LabelFormSize ?? "14px";

}
<style>
    .form-container {
        background: @bgColor;
    }

    .form-header p {
        font-size: @paragraphFontSize;
    }

    .form-header h1 {
        font-size: @headingFontSize;
        font-weight: @headingFontWeight;
    }

    .form-main-bg {
        width: @formWidth;
    }

    .form-field label {
        font-size: @LabelFormFontSize;
        color: @LabelFormFontColor;
    }

    @@media(max-width: 768px) {


        .form-main-bg {
            width: 100%;
        }

        .half-width {
            display: block;
            width: 100%;
            margin-right: 0;
            vertical-align: initial;
        }

        .form-header p {
            font-size: @MobileParagraphFontSize;
        }

        .form-header h1 {
            font-size: @MobileheadingFontSize;
            font-weight: @MobileheadingFontWeight;
        }

        .business-solution-card {
            height: 100%;
        }
    }

    .btnNext {
        height: unset !important;
        background: rgba(128, 144, 154, 0.2) !important;
        color: #80909A !important;
        max-width: 200px !important;
        padding: 18px 12px !important;
        border-radius: 50px !important;
        background: #00b140 !important;
        color: #fff !important;
        text-align: center !important;
        font-size: 16px !important;
        font-weight: 700 !important;
        line-height: 120% !important;
        text-transform: capitalize !important;
        margin: 40px auto !important;
        display: block !important;
        border: 1px solid rgba(41, 128, 189, 0.5);
    }

    .form-result-modal__content .form-result-modal__close {
        cursor: pointer;
    }

    .form-result-modal {
        position: fixed;
        inset: 0;
        display: none;
        z-index: 9999;
    }

        .form-result-modal.active {
            display: block;
        }

    .form-result-modal__overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.6);
    }

    .form-result-modal__content {
        position: relative;
        max-width: 600px;
        margin: 10vh auto;
        background: #fff;
        padding: 24px;
        border-radius: 8px;
        height: 372px;
    }

    .form-result-modal__close {
        position: absolute;
        top: 12px;
        right: 12px;
        font-size: 24px;
        background: none;
        border: none;
        cursor: pointer;
    }

    #goHomeBtn {
        margin-top: 70px;
    }

    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.6);
        display: none; /* hidden by default */
        justify-content: center;
        align-items: center;
    }

    .loader {
        width: 120px;
        height: 120px;
        border: 14px solid #eee;
        border-top: 14px solid #00cc44;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

@{
    async void RenderFormBody()
    {
        var statusDisplay = "hide";
        var message = ViewBag.Message;
        var submissionWarning = ViewBag.IsSuccess is not null && !ViewBag.IsSuccess;

        if (!ViewBag.IsWorkingInNonJSMode)
        {
            @await Html.PartialAsync("FormContainerInitScript", Model)
        }

        if ((ViewBag.FormFinalized || ViewBag.IsProgressiveSubmit)
             && (Model.SubmitSuccessMessage is null || Model.SubmitSuccessMessage.IsEmpty))
        {
            statusDisplay = "Form__Success__Message";
        }
        else if ((submissionWarning || (!ViewBag.Submittable && ViewBag.IsSuccess is null)) && !string.IsNullOrEmpty(message))
        {
            statusDisplay = "Form__Warning__Message";
        }

        <input type="hidden" class="Form__Element Form__SystemElement FormHidden FormHideInSummarized" name="__FormGuid" value="@Model.Form.FormGuid" data-f-type="hidden" />

        <input type="hidden" class="Form__Element Form__SystemElement FormHidden FormHideInSummarized" name="__FormHostedPage" value="@FormsExtensions.GetCurrentPageLink()?.ToString()" data-f-type="hidden" />
        <input type="hidden" class="Form__Element Form__SystemElement FormHidden FormHideInSummarized" name="__FormLanguage" value="@FormsExtensions.GetCurrentFormLanguage(Model)" data-f-type="hidden" />
        <input type="hidden" class="Form__Element Form__SystemElement FormHidden FormHideInSummarized" name="__FormCurrentStepIndex" value="@(ViewBag.CurrentStepIndex ?? " ")" data-f-type="hidden" />
        <input type="hidden" class="Form__Element Form__SystemElement FormHidden FormHideInSummarized" name="__FormSubmissionId" value="@ViewBag.FormSubmissionId" data-f-type="hidden" />
        @Html.GenerateAntiForgeryToken(Model)

        if (ViewBag.IsReadOnlyMode && !string.IsNullOrWhiteSpace(readOnlyModeMessage))
        {
            <div class="Form__Status">
                <span class="Form__Readonly__Message" role="alert">
                    @readOnlyModeMessage
                </span>
            </div>
        }


        RenderFormSuccessMessage();

        //area for showing Form's status or validation
        <div class="Form__Status">
            <div role="status" class="Form__Status__Message js-form-status-message @statusDisplay" data-f-form-statusmessage>
                @Html.Raw(message)
            </div>
        </div>
        <div>
            @{
                var currentStepIndex = ViewBag.CurrentStepIndex == null ? -1 : (int)ViewBag.CurrentStepIndex;
                string stepDisplaying;
            }
            @foreach (var step in Model.Form.Steps.Select((value, i) => new { i, value }))
            {
                stepDisplaying = (currentStepIndex == step.i && !ViewBag.FormFinalized && (bool)ViewBag.IsStepValidToDisplay) ? "" : "hide";
                var stepBlock = (step.value.SourceContent as ElementBlockBase);
                <section id="@step.value.ElementName" data-f-type="step" data-f-element-name="@step.value.ElementName" class="Form__Element FormStep Form__Element--NonData @stepDisplaying" data-f-stepindex="@step.i" data-f-element-nondata>
                    @if (stepBlock != null)
                    {
                        Html.RenderContentData(step.value.SourceContent, false);
                    }
                    @{
                        Html.RenderForm(step.i, step.value.Elements);
                    }
                </section>
            }

            @{
                var currentDisplayStepCount = Model.Form.Steps.Count();
                if (currentDisplayStepCount > 1 && currentStepIndex > -1 && currentStepIndex < currentDisplayStepCount && !ViewBag.FormFinalized)
                {
                    string prevButtonDisableState = (currentStepIndex == 0) || !ViewBag.Submittable ? "disabled" : "";
                    string nextButtonDisableState = (currentStepIndex == currentDisplayStepCount - 1) || !ViewBag.Submittable ? "disabled" : "";
                    if (Model.ShowNavigationBar)
                    {
                        <nav role="navigation" class="Form__NavigationBar" data-f-type="navigationbar" data-f-element-nondata>


                            <button type="submit" name="submit" value="@SubmitButtonType.NextStep.ToString()" class="Form__NavigationBar__Action FormExcludeDataRebind btnNext"
                                    @nextButtonDisableState data-f-navigation-next>
                                @Html.Translate("/episerver/forms/viewmode/stepnavigation/next")
                            </button>
                        </nav>
                    }
                }
            }
        </div>

    }

    async void RenderFormSuccessMessage()
    {
        if (Model.SubmitSuccessMessage is not null && !Model.SubmitSuccessMessage.IsEmpty && (ViewBag.FormFinalized || ViewBag.IsProgressiveSubmit))
        {
            <div class="Form__Success">
                <div role="status" class="Form__SubmissionSuccess__Message Form__Success__Message" id="Success__Message__@Model.Form.FormGuid" data-f-form-successmessage>
                    @{
                        Html.RenderFormXhtmlString(Model.SubmitSuccessMessage);
                    }
                </div>
            </div>
        }
    }
}


@if (currentMode == ContextMode.Edit)
{
    <link rel="stylesheet" type="text/css" data-f-resource="EPiServerForms.css" href='@EPiServer.Shell.Paths.ToClientResource(typeof(FormsModule), "ClientResources/ViewMode/EPiServerForms.css")' />

    @if (Model.Form != null)
    {
        <div class="EPiServerForms">
            <h2 class="Form__Title">@Html.PropertyFor(m => m.Title) </h2>
            <h4 class="Form__Description">@Html.PropertyFor(m => m.Description)</h4>
            @Html.PropertyFor(m => m.ElementsArea, new { Tag = "" })
        </div>
    }
    else
    {
        <div class="EPiServerForms">
            <span class="Form__Warning">@Html.Translate("/episerver/forms/editview/cannotbuildformmodel")</span>
        </div>
    }
}
else
{
    if (Model.Form != null)
    {
        @if (Model.IsEnquireForm)
        {
            @await Component.InvokeAsync(typeof(ConnectivityRemoveBlockViewComponent))
        }
        var validationCssClass = ViewBag.ValidationFail ? "ValidationFail" : "ValidationSuccess";
        if (ViewBag.RenderingFormUsingDivElement)
        {
            <div method="post" data-f-metadata="@Model.MetadataAttribute" class="EPiServerForms @validationCssClass" data-f-type="form" role="form" aria-labelledby="@formTitleId" id="@Model.Form.FormGuid">
                @{
                    RenderFormBody();
                }
            </div>
        }
        else
        {
            <section class="form-section">
                <div class="form-main-bg">
                    <div class="form-container">
                        <div class="form-header">
                            @if (!string.IsNullOrEmpty(Model.Title))
                            {
                                <h1 id="@formTitleId">@Model.Title</h1>
                            }
                            @if (Model.FormDescription != null)
                            {
                                <p>@Html.Raw(Model.FormDescription)</p>
                            }
                        </div>
                        <div class="form-box">
                            <form method="post" novalidate="novalidate"
                                  data-f-metadata="@Model.MetadataAttribute" aria-labelledby="@formTitleId"
                                  enctype="multipart/form-data" class="EPiServerForms @validationCssClass" data-f-type="form" id="@Model.Form.FormGuid">

                                @{
                                    RenderFormBody();
                                }

                                @if (!String.IsNullOrWhiteSpace(Model?.FormFooterMessage))
                                {
                                    <div class="form-info-message">
                                        <span class="info-icon">i</span>
                                        @Html.Raw(Model.FormFooterMessage)
                                    </div>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        }

    }
}
<div id="formResultModal" class="form-result-modal" aria-hidden="true">
    <div class="form-result-modal__overlay"></div>

    <div class="form-result-modal__content" role="dialog" aria-modal="true">
        <button type="button" class="form-result-modal__close" aria-label="Close">
            ×
        </button>

        <h2 id="modalTitle"></h2>
        <div id="modalMessage"></div>
    </div>
</div>

<div id="formLoader" class="loader-overlay">
    <div class="loader"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("formResultModal");
        const titleEl = document.getElementById("modalTitle");
        const messageEl = document.getElementById("modalMessage");
           function showLoader(){
              document.querySelectorAll(".loader-overlay").forEach(el => el.style.display = "flex");
        }

        function hideLoader(){
              document.querySelectorAll(".loader-overlay").forEach(el => el.style.display = "none");
        }

        const hasProducts = document.querySelectorAll(".business-solution-card").length > 0;
                   const buttons = document.querySelectorAll(
        ".b2bsubmitbuttonelementblock, .btnNext"
    );
        const sectionHeader=document.querySelector('.business-section-header');
        if (!hasProducts && sectionHeader) {
            document.querySelector('.business-section-header').style.display='block'
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.style.pointerEvents = "none";
                btn.style.opacity = "0.5";
            });
        }

        if (typeof $$epiforms !== "undefined") {
            const productHeadings = document.querySelector("input.product_headings");
            $$epiforms(".EPiServerForms").on("formsStepValidating formsNavigateToStep afterNavigateNextStep",function(event){
                  showLoader();
                    if (productHeadings) {
                        sendProductLabelsAndHeading();
                    }
                    if(event && !event?.isValid){
                        hideLoader();
                    }
               })
               .on("formsSubmitted formsSubmittedError",  function (event, data) {
                    hideLoader();
                    if (event.isSuccess && productHeadings) {
                        removeSelectedProducts(false);
                        openModal(event.returnedResult.message);
                    }
               });
        }

        function sendProductLabelsAndHeading(){
            const productHeadings=document.querySelector("input.product_headings");
            const productLabels=document.querySelector("input.product_labels");
    const cards = document.querySelectorAll(".business-solution-card");

    let grouped = {};

    cards.forEach(card => {

        const heading = card.querySelector("h3")?.innerText?.trim();
        const labels = Array.from(card.querySelectorAll(".business-label"))
            .map(x => x.innerText.trim());

        if (!heading) return;

        // init group
        if (!grouped[heading]) {
            grouped[heading] = {
                labels: new Set()
            };
        }

        // add heading itself into labels
        grouped[heading].labels.add(heading);

            // add all labels
            labels.forEach(l => grouped[heading].labels.add(l));
        });

        let product_headings = [];
        let product_labels = [];

        Object.keys(grouped).forEach(heading => {
            product_headings.push(heading);

            const labelString = Array.from(grouped[heading].labels).join(", ");
            product_labels.push(`${heading} (${labelString})`);
        });
            productHeadings.value = product_headings.join(", ");
            productLabels.value = product_labels.join(", ");
        }
        function openModal(title) {
            if (!modal || !title) return;
            const homeUrl = "@UrlResolver.GetUrl(Model?.SuccessRedirectURL?.Href)";
            titleEl.innerHTML=title;
            messageEl.innerHTML = `
                <button id="goHomeBtn" title=@Model?.SuccessRedirectURL?.Title class="button button-theme--primary">
                    <span>@Model?.SuccessRedirectURL?.Text</span>
                    <div class="arrow">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
             </button>
            `;
            modal.classList.add("active");
            document.getElementById("goHomeBtn")?.addEventListener("click", function () {
                window.location.href = homeUrl;
            });
        }
            function removeSelectedProducts(reload) {
      var url = '@Url.Action("RemoveSelectedProducts", "B2BFormApi")';

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Request failed with status " + response.status);
                    }
                    return response.json(); // now safe
                })
                .then(data => {
                    console.log("Success:", data);

                    if (data.success && reload == true) {
                         window.location.href = window.location.pathname;
                    }
                })
                .catch(error => {
                    console.error("Error:", error);
                });
            }
        document.addEventListener("click", function (e) {
            if (
                e.target.classList.contains("form-result-modal__overlay") ||
                e.target.classList.contains("form-result-modal__close")
            ) {
                removeSelectedProducts(true);
                modal.classList.remove("active");
            }
        });
    });
</script>