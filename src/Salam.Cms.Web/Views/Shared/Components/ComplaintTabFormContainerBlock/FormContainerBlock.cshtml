<script>
    document.addEventListener('DOMContentLoaded', function () {
        sessionStorage.clear();
        hideLoader();
       function updateNextButtonText() {
               const nextBtn = document.querySelector(".Form__NavigationBar .btnNext");
               if (!nextBtn) return;
               const activeStep = document.querySelector('.FormStep:not(.hide)');
               if (!activeStep) return;
               const btnText = activeStep.dataset.btnText;
               if (btnText && btnText.trim() !== "") {
                   nextBtn.innerText = btnText;
           }
       }
        updateNextButtonText();
        const successContainer = document.querySelector(".success-container");
        const errorContainer = document.querySelector(".message-container.error");
        successContainer.style.display = "none";
        errorContainer.style.display = "none";
            function updateNavigationCircles() {
                const activeTab = document.querySelector('.tabs-container .tab.active');
                if (!activeTab) return;
                const tabId = activeTab.dataset.tab;
                const visibleStep = document.querySelector("section.FormStep:not(.hide)");
                if (!visibleStep) return;
                const currentIndex = parseInt(visibleStep.dataset.fStepindex, 10) +1;
                const circles = document.querySelectorAll('.navigation-circle .step-circle');
                const lines = document.querySelectorAll('.navigation-circle .line');
                if(tabId == "trackTab"){
                    for (let i = 0; i < circles.length; i++) {
                        circles[i].style.display = "none";
                    }
                    for (let i = 0; i < lines.length; i++) {
                        lines[i].style.display = "none";
                    }
                }else{
                    for (let i = 0; i < circles.length; i++) {
                        circles[i].style.display = "block";
                    }
                    for (let i = 0; i < lines.length; i++) {
                        lines[i].style.display = "block";
                    }
                }
                circles.forEach(circle => {
                    const stepNum = parseInt(circle.dataset.step, 10);
                    if (stepNum < currentIndex) {
                        circle.classList.add("completed");
                        circle.classList.remove("active", "upcoming");
                    }
                    else if (stepNum === currentIndex) {
                        circle.classList.add("active");
                        circle.classList.remove("completed", "upcoming");
                    }
                    else {
                        circle.classList.add("upcoming");
                        circle.classList.remove("completed", "active");
                    }
                });
                lines.forEach((line, idx) => {
                    const stepBefore = idx + 1;
                    if (stepBefore < currentIndex) {
                        line.classList.add("completed");
                    } else {
                        line.classList.remove("completed");
                    }
                });
            }


       function MobilePhoneComparison(){
            const verifiedMobileNum = document.querySelector(".salam_mobile_number.form-input");
            const SalamMobileNum = document.querySelector(".mobilenumber.form-input");

            if (verifiedMobileNum && SalamMobileNum) {
                SalamMobileNum.disabled=true;
                const value1 = SalamMobileNum.value.trim();
                const value2 = verifiedMobileNum.value.trim();

                if (value1 == value2) {
                    alert("Mobile Number and Salam Mobile Number could not be same");
                    return true;
                }
            }
            return false;
    }


        function setAdditionalTicketDetailsParam(data) {
            const extra = data.returnedResult?.additionalParams || {};

            if (extra.ticketNumber) {
                document.getElementById("TicketNumber").textContent = extra.ticketNumber;
            }
            if (extra.ticketOpenStatus) {
                document.getElementById("ticketOpenStatus").textContent = extra.ticketOpenStatus;
            }
            if (extra.ticketClosedStatus) {
                document.getElementById("ticketClosedStatus").textContent = extra.ticketClosedStatus;
            }
            if (extra.ticketMobileNumber) {
                document.getElementById("ticketMobileNumber").textContent = extra.ticketMobileNumber;
            }
        }

        if (typeof $$epiforms !== "undefined") {
            $$epiforms(".EPiServerForms").on("formsSubmitted", function (event, data) {
                showLoader();
                const visibeFinalStep = document.querySelector("section.FormStep:not(.hide)");
                const formContainer = document.querySelector(".EPiServerForms");
                if (!visibeFinalStep) return;
                const FinalIndex = parseInt(visibeFinalStep.dataset.fStepindex, 10) +1;
                const activeTab = document.querySelector('.tabs-container .tab.active');
                if (!activeTab) return;
                const tabId = activeTab.dataset.tab;
                if(FinalIndex==1 && tabId == "trackTab"){
                      showLoader();
                        if (event.isSuccess) {
                            setAdditionalTicketDetailsParam(event);
                            document.querySelectorAll('.EPiServerForms .Form__NavigationBar').forEach(el => {
                                el.remove();
                            });
                        }else{
                            alert("Reference number Complaint does not exist");
                        }
                    hideLoader();
                }
                if(FinalIndex ==3){
                    if (event.isSuccess) {
                        successContainer.style.display = "flex";
                        if (formContainer) {
                            formContainer.style.display = "none";
                        }
                        if (event.returnedResult && event.returnedResult.message) {
                            document.getElementById("ticketNumber").innerText = event.returnedResult.message;
                        }
                    } else {
                        if (formContainer) {
                            formContainer.style.display = "none";
                        }
                        errorContainer.style.display = "flex";
                    }
                }
                hideLoader();
            });
        }
        function updateMobileNumberText(){
                const mobileField = document.querySelector("input.mobilenumber");
                if (mobileField?.value !== null && mobileField?.value !== "" && mobileField?.value.length >9) {
                       let el = document.getElementById("mobilenumber");
                       let currentText = el.innerText;
                       let updatedText = currentText.replace('MobileNumber', mobileField?.value );
                       el.innerText = updatedText;
                }
           }

                   if (typeof $$epiforms !== 'undefined') {

        $$epiforms('.EPiServerForms')
            .on('formsStartSubmitting', function () {
                showLoader();
            })

            .on('formsSubmitted', function () {
                hideLoader();
            })

            .on('formsSubmittedError', function () {
                      hideLoader();
            });
    }
        function updateDisabledInputValue(){
            const mobileField = document.querySelector("input.mobilenumber");
            const disabledField = document.querySelector("input[disabled]");
            const visibeFinalStep = document.querySelector("section.FormStep:not(.hide)");
            if (!visibeFinalStep) return;
            const FinalIndex = parseInt(visibeFinalStep.dataset.fStepindex, 10) +1;
            if(FinalIndex == 3){
                if (mobileField && disabledField) {
                    localStorage.setItem("mobileValue", mobileField.value);
                    const savedValue = localStorage.getItem("mobileValue");
                    if (savedValue !== null) {
                      disabledField.disabled = false;
                      disabledField.value = savedValue;
                      disabledField.disabled = true;
                    }
                    localStorage.removeItem("mobileValue");
                }
            }
        }

        function updateNextState() {
            const activeTab = document.querySelector('.tabs-container .tab.active');
            if (!activeTab) return;
            const tabId = activeTab.dataset.tab;
            const tabSection = document.getElementById(tabId);
            const subCategory = document.querySelector("select[name='SubCategory']");
            const tier2Form = subCategory?.selectedOptions[0]?.value;
            const tier1Form = subCategory?.selectedOptions[0]?.dataset.tier1;
            const tier2 = document.querySelector(".tier2");
            const tier1 = document.querySelector(".tier1");
            if (tier1) tier1.value = tier1Form || "";
            if (tier2) tier2.value = tier2Form || "";
            const tier3Form = subCategory?.selectedOptions[0]?.dataset.tier3;
            const tier3 = document.querySelector(".tier3");
            if (tier3) tier3.value = tier3Form || "";
            if (!tabSection) return;
            const visibleStep = tabSection.querySelector(
                "section.Form__Element.FormStep.Form__Element--NonData:not(.hide)"
            );
            if (!visibleStep) return;
            const nextBtn = tabSection.querySelector(".Form__NavigationBar .btnNext") || document.querySelector(".Form__NavigationBar .btnNext");
            if (!nextBtn) return;
            const requiredFields = Array.from(
                visibleStep.querySelectorAll("input[required], textarea[required], select")
            ).filter(field => {
                const isVisible =
                    field.offsetParent !== null &&
                    window.getComputedStyle(field).display !== "none" &&
                    !field.closest(".hide");
                const isEmptySelect = field.tagName.toLowerCase() === "select" && field.value.trim() === "";
                if (isEmptySelect) return true;
                return field.required && !field.disabled && isVisible;
            });
            let allValid = true;
            requiredFields.forEach(field => {
                if (!field.value.trim() || !field.checkValidity()) {
                    allValid = false;
                }
            });
            nextBtn.disabled = !allValid;
            nextBtn.classList.toggle("disabled", !allValid);
        }

        const tabss = document.querySelectorAll('.tabs-container .tab');
        tabss.forEach(tab => {
            tab.addEventListener('click', function () {
                setTimeout(() => {
                    updateNextState();
                    updateNavigationCircles();
                }, 50);
            });
        });

       document.addEventListener("click", function (e) {
           const btn = e.target.closest("button[data-f-navigation-next]");
           if (!btn) return;
           const visibleStep = document.querySelector("section.FormStep:not(.hide)");
           if (!visibleStep) return;
           const stepIndex = parseInt(visibleStep.dataset.fStepindex, 10)+1;
           if(stepIndex == 1){
               updateMobileNumberText();
           }
          if (stepIndex == 3) {
               var isDuplicate = MobilePhoneComparison();
               if(isDuplicate){
                   e.preventDefault();
                   e.stopImmediatePropagation();
                   return;
               }
           }
       }, true);

        function showLoader(){
              document.querySelectorAll(".loader-overlay").forEach(el => el.style.display = "flex");
        }

        function hideLoader(){
              document.querySelectorAll(".loader-overlay").forEach(el => el.style.display = "none");
        }

       $$epiforms('.EPiServerForms')
               .on('formsStepValidating formsNavigateToStep afterNavigateNextStep formsSetupCompleted formsStepValidating', function () {
                   setTimeout(updateNextButtonText, 50);
                   updateNextState
                   updateDisabledInputValue
       });

        // Field changes
        document.body.addEventListener("input", ()=>{
                 updateNextState();
                 updateNavigationCircles();
        });

        document.body.addEventListener("change", ()=>{
                 updateNextState();
                 updateNavigationCircles();
        });

        // Step navigation buttons
        document.body.addEventListener("click", function (e) {
            if (e.target.matches(".btnNext, .btnPrev")) {
                 showLoader();
                    setTimeout(() => {
                        updateNextState();
                        updateNavigationCircles();
                        updateDisabledInputValue();
                        hideLoader();
                    }, 20);
                }
        });

        // Run initial check
        updateNextState();
        updateNavigationCircles();
        updateDisabledInputValue();
    });
</script>