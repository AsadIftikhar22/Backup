@using EPiServer.Core
@using EPiServer.ServiceLocation
@using Salam.Cms.Web.Features.Home.ViewModels
@inject EPiServer.Web.Routing.UrlResolver UrlResolver
@using EPiServer
@model IframePageViewModel

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><script src="https://cdn.jsdelivr.net/npm/[email protected]/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

@{
    Layout = "~/Views/Shared/_Iframe_Layout.cshtml";
    ImageData imageData = new();
    @if (Model.CurrentPage?.Media != null)
    {
        var contentLoader = ServiceLocator.Current.GetInstance<IContentLoader>();
        imageData = contentLoader.Get<ImageData>(Model.CurrentPage?.Media);
    }

}

@Html.Raw(Model.CurrentPage?.HTMLCSS)
@Html.Raw(Model.CurrentPage?.HTMLBody)
@Html.PropertyFor(x => x.CurrentPage.MainContent, new { CssClass = "section-container bg-ltr" })

@if(LinkItemExtensions.IsValid(Model?.CurrentPage?.ImageRedirectURL))
{
  <script>
    document.body.addEventListener("click", function (e) {
        if (e.target === document.body) {
            window.open("@Model?.CurrentPage?.ImageRedirectURL.Href", "@Model?.CurrentPage?.ImageRedirectURL.Target");
        }
    });
</script>  
}

<style>

    html, body {
        width: 100%;
        height: 100%;
    }
    @if (Model.CurrentPage?.Media != null)
    {
        <text>
        body {
            background: url('@Url.ContentUrl(imageData?.ContentLink)') center center / cover no-repeat fixed !important;
            cursor: pointer !important;
        }
        </text>
    }


        body * {
            background-color: transparent !important;
            background-image: none !important;
        }
</style>